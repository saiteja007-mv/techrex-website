---
import BaseLayout from '../layouts/BaseLayout.astro';
import channelInfo from '../data/channel-info.json';
import localModelsData from '../data/local-models.generated.json';

const { socialLinks } = channelInfo;

// Local-models advisor data — full catalog ships statically.
// Engine logic lives in the inline <script> at the bottom of this file (initLocalModels).
const localModels = localModelsData.models;

type InstallStep = {
  title: string;
  description?: string;
  command?: string;
  note?: string;
};

type InstallTab = {
  os: 'macOS' | 'Windows' | 'Linux';
  steps: InstallStep[];
  note?: string;
  verify?: string;
};

type CliTool = {
  name: string;
  emoji: string;
  description: string;
  category: string;
  color: 'mint' | 'violet' | 'amber' | 'pink';
  status: 'Live' | 'Coming Soon';
  installTabs: InstallTab[];
  docsUrl: string;
  shortUrl: string | null;
  agentPrompt: string;
};

const cliTools: CliTool[] = [
  {
    name: 'Vercel CLI',
    emoji: '▲',
    description: 'Deploy projects, manage env vars, and preview deployments from the terminal.',
    category: 'Deployment',
    color: 'mint',
    status: 'Live',
    agentPrompt: '"Use the Vercel CLI to deploy this project to production" · "Pull my production env vars into .env.local" · "List my last 10 deployments"',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install Vercel CLI globally via npm', description: 'Requires Node.js 18+. Global flag puts the `vercel` binary on your PATH so any agent shell can invoke it.', command: 'npm install -g vercel' },
          { title: '(Alternative) Install via pnpm, yarn, or bun', description: 'Any Node package manager works. Pick the one you already use.', command: 'pnpm add -g vercel' },
          { title: 'Log in to your Vercel account', description: 'Opens a browser tab. Pick the same sign-in method (GitHub, GitLab, Bitbucket, or email) you use on vercel.com. Token is saved to `~/.local/share/com.vercel.cli/auth.json`.', command: 'vercel login' },
          { title: 'Link a local project', description: 'Run inside your project directory. Creates a `.vercel/` folder with the project + org IDs so every subsequent command targets this project.', command: 'vercel link' },
          { title: '(Optional) Pull production env vars', description: 'Writes `.env.local` from your Vercel project — handy for local dev and for AI agents that need the same secrets.', command: 'vercel env pull' },
        ],
        verify: 'vercel --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install Node.js LTS (prerequisite)', description: 'Vercel CLI is a Node package. In an elevated PowerShell, install the LTS build. Skip this step if `node --version` already returns 18+.', command: 'winget install OpenJS.NodeJS.LTS' },
          { title: 'Open a FRESH PowerShell window', description: 'The Node installer modifies PATH. Existing terminals will not see `node`/`npm` until you reopen them.' },
          { title: 'Install Vercel CLI globally', description: 'Global flag is what makes `vercel` available to any shell / AI agent.', command: 'npm install -g vercel' },
          { title: 'Log in to your Vercel account', description: 'Opens your default browser. Pick the same sign-in method you use on vercel.com. The access token is stored at %APPDATA%\\com.vercel.cli\\auth.json.', command: 'vercel login' },
          { title: 'Link a local project', description: 'From your project directory. Select the Vercel team + project to link. Creates a `.vercel/` folder you should NOT commit.', command: 'vercel link' },
          { title: '(Optional) Pull production env vars', description: 'Writes `.env.local` so local + agent commands see the same secrets as production.', command: 'vercel env pull' },
        ],
        note: 'Avoid installing Node via the Microsoft Store — it sandboxes global installs and `npm install -g` silently fails. If you see EACCES errors, follow npm\'s permissions guide: https://docs.npmjs.com/resolving-eacces-permissions-errors.',
        verify: 'vercel --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Install Node.js 18+ via nvm (recommended)', description: 'nvm avoids the `sudo npm -g` permissions dance and lets you switch versions per project.', command: 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash && source ~/.bashrc && nvm install --lts' },
          { title: 'Install Vercel CLI globally', command: 'npm install -g vercel' },
          { title: 'Log in to your Vercel account', description: 'Prints a URL + one-time code. Copy the URL to a browser (useful on headless boxes).', command: 'vercel login' },
          { title: 'Link a local project', command: 'vercel link' },
          { title: '(Optional) Pull production env vars', command: 'vercel env pull' },
        ],
        verify: 'vercel --version',
      },
    ],
    docsUrl: 'https://vercel.com/docs/cli',
    shortUrl: null,
  },
  {
    name: 'GitHub CLI',
    emoji: '🐙',
    description: 'Create PRs, manage issues, clone repos, and run workflows without leaving your terminal.',
    category: 'Version Control',
    color: 'violet',
    status: 'Live',
    agentPrompt: '"Use the GitHub CLI to open a PR from this branch" · "List my open issues across all repos" · "Trigger the deploy.yml workflow on main"',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew', description: 'Official formula. Updates with `brew upgrade gh`.', command: 'brew install gh' },
          { title: 'Authenticate with GitHub', description: 'Interactive prompts: pick GitHub.com → HTTPS → "Login with a web browser". Copy the one-time code it prints, paste it at github.com/login/device, authorize.', command: 'gh auth login' },
          { title: 'Verify auth', description: 'Should print `Logged in to github.com as <your-username>` and show the token scopes.', command: 'gh auth status' },
        ],
        verify: 'gh --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install via winget (recommended)', description: 'The WinGet package is the only one maintained by the GitHub CLI team. Run in PowerShell — a UAC prompt will appear.', command: 'winget install --id GitHub.cli' },
          { title: '(Alternative) Install via Scoop', description: 'Community-maintained. Good if you already use Scoop for dev tooling.', command: 'scoop install gh' },
          { title: '(Alternative) Install via Chocolatey', description: 'Community-maintained. Requires Chocolatey installed first.', command: 'choco install gh' },
          { title: 'Open a FRESH PowerShell or Terminal window', description: 'The installer modifies PATH — existing shells will not see `gh` until they are restarted.' },
          { title: 'Authenticate with GitHub', description: 'Interactive prompts. Recommended answers: GitHub.com → HTTPS → Yes (auth git with gh credentials) → Login with a web browser. It prints a one-time code; paste it at github.com/login/device and authorize.', command: 'gh auth login' },
          { title: '(Alternative) Authenticate with a Personal Access Token', description: 'If you cannot use the browser flow (CI, agent-only machine), create a classic PAT at github.com/settings/tokens, then pipe it in. Replace YOUR_PAT with the token.', command: 'echo YOUR_PAT | gh auth login --with-token' },
          { title: 'Verify auth', description: 'Confirms gh can talk to the API and lists the token scopes.', command: 'gh auth status' },
        ],
        note: 'WinGet uses the official signed installer. Choco/Scoop are community forks — if anything breaks, fall back to WinGet or download the .msi from https://github.com/cli/cli/releases/latest.',
        verify: 'gh --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Add the GitHub CLI apt keyring (Debian / Ubuntu)', description: 'For Fedora / RHEL / openSUSE, see the official install docs — each distro has a one-liner.', command: '(type -p wget >/dev/null || (sudo apt update && sudo apt-get install wget -y)) && sudo mkdir -p -m 755 /etc/apt/keyrings && wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null && sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg' },
          { title: 'Add the apt source list', command: 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null' },
          { title: 'Install gh', command: 'sudo apt update && sudo apt install gh -y' },
          { title: 'Authenticate with GitHub', description: 'GitHub.com → HTTPS → browser flow. Copy the one-time code to github.com/login/device.', command: 'gh auth login' },
          { title: 'Verify auth', command: 'gh auth status' },
        ],
        verify: 'gh --version',
      },
    ],
    docsUrl: 'https://cli.github.com/',
    shortUrl: null,
  },
  {
    name: 'Supabase CLI',
    emoji: '⚡',
    description: 'Spin up local Supabase, run migrations, and deploy edge functions from your terminal.',
    category: 'Database',
    color: 'amber',
    status: 'Live',
    agentPrompt: '"Use the Supabase CLI to start a local stack" · "Create a migration for a new posts table" · "Generate TypeScript types from my remote database" · "Deploy the send-email edge function"',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew tap', description: 'Official tap maintained by Supabase. Updates with `brew upgrade supabase`.', command: 'brew install supabase/tap/supabase' },
          { title: 'Log in to Supabase', description: 'Opens a browser, generates a personal access token, and saves it to `~/.supabase/access-token`.', command: 'supabase login' },
          { title: 'Initialize a new project directory', description: 'Creates `supabase/config.toml` and the migrations folder. Run in an empty or existing app directory.', command: 'supabase init' },
          { title: 'Link to your cloud project', description: 'Find <project-ref> in your Supabase dashboard URL: https://supabase.com/dashboard/project/<ref>. This lets `supabase db push`, functions deploy, etc. target the right project.', command: 'supabase link --project-ref <your-project-ref>' },
          { title: '(Optional) Start the local stack', description: 'Requires Docker Desktop running. Spins up Postgres + Auth + Storage + Studio on localhost.', command: 'supabase start' },
        ],
        verify: 'supabase --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install Scoop (if you don\'t have it)', description: 'Scoop is the only supported Windows installer for Supabase CLI. Run in a NON-admin PowerShell — Scoop installs per-user.', command: 'Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser; irm get.scoop.sh | iex' },
          { title: 'Add the Supabase Scoop bucket', description: 'Pulls the bucket manifest from Supabase\'s official scoop repo.', command: 'scoop bucket add supabase https://github.com/supabase/scoop-bucket.git' },
          { title: 'Install Supabase CLI', description: 'Scoop downloads the prebuilt Windows binary and adds it to PATH.', command: 'scoop install supabase' },
          { title: 'Log in to Supabase', description: 'Opens your default browser. Click "Authorize" on the Supabase consent screen. The token is stored under %USERPROFILE%\\.supabase\\.', command: 'supabase login' },
          { title: 'Initialize a new project directory', description: 'Creates `supabase/config.toml`. Run in an empty directory (or your app\'s root).', command: 'supabase init' },
          { title: 'Link to your cloud project', description: 'Get <project-ref> from your Supabase dashboard URL (the 20-char slug after /project/).', command: 'supabase link --project-ref <your-project-ref>' },
          { title: '(Optional) Start the local stack', description: 'Requires Docker Desktop for Windows installed and running.', command: 'supabase start' },
        ],
        note: 'Supabase EXPLICITLY does not support `npm install -g supabase`. On Windows, use Scoop. Do not follow random Stack Overflow answers telling you to npm-install it globally — it will silently break.',
        verify: 'supabase --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Install via Homebrew on Linux (recommended)', description: 'Linuxbrew works cross-distro and gets updates fastest.', command: 'brew install supabase/tap/supabase' },
          { title: '(Alternative) Install as a dev dependency', description: 'Global npm install is NOT supported. Use it as a per-project devDependency and run via `npx supabase`.', command: 'npm install supabase --save-dev' },
          { title: '(Alternative) Download a prebuilt release', description: 'Grab the .tar.gz for your arch from https://github.com/supabase/cli/releases and drop `supabase` into /usr/local/bin.' },
          { title: 'Log in to Supabase', command: 'supabase login' },
          { title: 'Initialize a new project directory', command: 'supabase init' },
          { title: 'Link to your cloud project', command: 'supabase link --project-ref <your-project-ref>' },
          { title: '(Optional) Start the local stack', description: 'Requires Docker Engine running.', command: 'supabase start' },
        ],
        verify: 'supabase --version',
      },
    ],
    docsUrl: 'https://supabase.com/docs/guides/local-development/cli/getting-started',
    shortUrl: null,
  },
  {
    name: 'AWS CLI',
    emoji: '☁️',
    description: 'Manage AWS services, configure credentials, and automate cloud infrastructure.',
    category: 'Cloud',
    color: 'pink',
    status: 'Live',
    agentPrompt: '"Use the AWS CLI to list my S3 buckets" · "Describe the EC2 instance i-abc123" · "Tail CloudWatch logs for /aws/lambda/my-func" · "Deploy this Lambda zip"',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install the signed .pkg (recommended)', description: 'Official AWS-signed package. Most up-to-date and supported path.', command: 'curl "https://awscli.amazonaws.com/AWSCLIV2.pkg" -o "AWSCLIV2.pkg" && sudo installer -pkg AWSCLIV2.pkg -target /' },
          { title: '(Alternative) Install via Homebrew', description: 'Community-maintained. Usually a few days behind upstream but simpler.', command: 'brew install awscli' },
          { title: 'Create an IAM user + access keys in AWS Console', description: 'Sign in to AWS Console → IAM → Users → Create user → attach a least-privilege policy (NEVER use root keys) → Security credentials tab → Create access key → select "CLI" as the use case. Copy the Access Key ID and Secret Access Key — the secret is shown only once.' },
          { title: 'Configure credentials', description: 'Prompts for 4 values: Access Key ID, Secret Access Key, default region (e.g. us-east-1), default output format (json / text / table). Stored in ~/.aws/credentials and ~/.aws/config.', command: 'aws configure' },
          { title: 'Test your credentials', description: 'Returns your account ID, user ARN, and user ID. If this fails, your keys are wrong or your user has no permissions.', command: 'aws sts get-caller-identity' },
        ],
        verify: 'aws --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install via MSI (recommended)', description: 'Runs the official AWS-signed MSI silently. Adds `aws` to the system PATH. Open an ELEVATED PowerShell (Run as Administrator).', command: 'msiexec.exe /i https://awscli.amazonaws.com/AWSCLIV2.msi /qn' },
          { title: '(Alternative) Install via winget', description: 'Works in a normal PowerShell — winget handles the elevation prompt.', command: 'winget install --id Amazon.AWSCLI' },
          { title: '(Alternative) Download + run the MSI manually', description: 'If you cannot run commands as admin, download the MSI from https://awscli.amazonaws.com/AWSCLIV2.msi and double-click it.' },
          { title: 'Open a FRESH PowerShell window', description: 'MSI modifies the SYSTEM PATH — open a brand-new PowerShell / Terminal so `aws` is on PATH. Existing ones will say "command not found".' },
          { title: 'Create an IAM user + access keys in AWS Console', description: 'AWS Console → IAM → Users → Create user → attach a least-privilege policy (e.g. PowerUserAccess for dev, NOT root keys) → the new user → Security credentials → Create access key → select "Command Line Interface (CLI)" → confirm. Copy both the Access Key ID and the Secret Access Key. The Secret is shown only once — save it immediately.' },
          { title: 'Configure credentials', description: 'Prompts for 4 values: AWS Access Key ID, AWS Secret Access Key, Default region (e.g. us-east-1), Default output (json). Stored at %USERPROFILE%\\.aws\\credentials and %USERPROFILE%\\.aws\\config.', command: 'aws configure' },
          { title: '(Optional) Set up a named profile for multiple accounts', description: 'If you have work + personal AWS accounts, configure each under its own profile. Then use `aws --profile work s3 ls`, etc.', command: 'aws configure --profile work' },
          { title: 'Test your credentials', description: 'Returns your AWS account ID + user ARN. If this errors, your keys are wrong or the user has no permission.', command: 'aws sts get-caller-identity' },
        ],
        note: 'NEVER commit %USERPROFILE%\\.aws\\credentials to git. For CI or AI agents, prefer AWS IAM Identity Center SSO (`aws configure sso`) over long-lived access keys.',
        verify: 'aws --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Download the v2 installer (x86_64)', description: 'For ARM64 (Graviton, Raspberry Pi), use awscli-exe-linux-aarch64.zip instead.', command: 'curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"' },
          { title: 'Unzip the installer', command: 'unzip awscliv2.zip' },
          { title: 'Run the installer', description: 'Installs to /usr/local/aws-cli/ and symlinks `aws` into /usr/local/bin/.', command: 'sudo ./aws/install' },
          { title: '(Alternative) Snap install', description: 'One-liner on distros with snapd (Ubuntu, Fedora with snapd).', command: 'sudo snap install aws-cli --classic' },
          { title: 'Create an IAM user + access keys', description: 'Same as the Windows step: AWS Console → IAM → create dedicated CLI user → attach least-privilege policy → generate access keys.' },
          { title: 'Configure credentials', command: 'aws configure' },
          { title: 'Test your credentials', command: 'aws sts get-caller-identity' },
        ],
        verify: 'aws --version',
      },
    ],
    docsUrl: 'https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html',
    shortUrl: null,
  },
  {
    name: 'Google Workspace CLI',
    emoji: '🟩',
    description: 'Official Google Workspace CLI for managing Drive, Gmail, Calendar, and admin resources from the terminal.',
    category: 'Productivity',
    color: 'mint',
    status: 'Live',
    agentPrompt: '"Use the gws CLI to list my 10 most recent Drive files" · "Draft a Gmail reply to this thread" · "Create a Calendar event for tomorrow 3pm"',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew (easiest)', description: 'Pulls a signed prebuilt binary. No Rust or Node toolchain needed.', command: 'brew install googleworkspace-cli' },
          { title: '(Alternative) Install via npm', description: 'Official npm wrapper. Requires Node.js 18+.', command: 'npm install -g @googleworkspace/cli' },
          { title: '(Alternative) Install from source with Cargo', description: 'The CLI is written in Rust. Only needed if you want the bleeding edge.', command: 'cargo install --git https://github.com/googleworkspace/cli --locked' },
          { title: 'Install gcloud CLI (for automated auth)', description: 'Easiest auth path uses gcloud to provision the GCP project for you.', command: 'brew install --cask google-cloud-sdk' },
          { title: 'Automated setup via gcloud', description: 'Creates a Google Cloud project, enables the Workspace APIs, generates OAuth credentials, and opens a browser to log in. One command does everything.', command: 'gws auth setup' },
          { title: 'Verify auth', description: 'Should return a JSON list of your 5 most recent Drive files.', command: 'gws drive files list --params \'{"pageSize": 5}\'' },
        ],
        verify: 'gws --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install Node.js LTS (prerequisite for npm path)', description: 'Skip if `node --version` already returns 18+.', command: 'winget install OpenJS.NodeJS.LTS' },
          { title: 'Open a FRESH PowerShell window', description: 'PATH refresh. Required after Node install.' },
          { title: 'Install Google Workspace CLI globally via npm', description: 'On Windows, the npm path is the easiest — no Rust toolchain, no manual PATH edits.', command: 'npm install -g @googleworkspace/cli' },
          { title: '(Alternative) Download a prebuilt Windows binary', description: 'From https://github.com/googleworkspace/cli/releases — grab the .exe for windows-x86_64, place it in a folder on your PATH (e.g. C:\\tools\\gws.exe).' },
          { title: 'Install gcloud CLI (for automated auth)', description: 'Google Cloud SDK includes the gcloud binary `gws auth setup` depends on. Elevated PowerShell required.', command: 'winget install Google.CloudSDK' },
          { title: 'Automated setup via gcloud', description: 'Creates a GCP project, enables the Workspace APIs (Drive, Gmail, Calendar, etc.), generates OAuth credentials, and opens a browser to complete the OAuth flow. Credentials saved to %USERPROFILE%\\.config\\gws\\.', command: 'gws auth setup' },
          { title: '(Manual alternative) Set up OAuth credentials yourself', description: 'If you prefer not to install gcloud: go to console.cloud.google.com/apis/credentials → Create Credentials → OAuth client ID → Desktop app. Download the JSON, save it as %USERPROFILE%\\.config\\gws\\client_secret.json, then run `gws auth login` to complete the browser flow.', command: 'gws auth login' },
          { title: 'Verify auth', description: 'Lists your 5 most recent Drive files as JSON. If this errors with 401, re-run `gws auth setup` or `gws auth login`.', command: 'gws drive files list --params "{\\"pageSize\\": 5}"' },
        ],
        note: 'The CLI is written in Rust but is distributed as prebuilt binaries — you do NOT need to install Rust or Go on Windows. Use the npm package or the GitHub release binaries.',
        verify: 'gws --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Install via Homebrew on Linux (simplest)', description: 'Works across distros via Linuxbrew. Gets signed binaries.', command: 'brew install googleworkspace-cli' },
          { title: '(Alternative) Install via npm', description: 'Requires Node.js 18+. Works everywhere.', command: 'npm install -g @googleworkspace/cli' },
          { title: '(Alternative) Install from source', description: 'Requires Rust toolchain (`rustup`). Builds from the official repo.', command: 'cargo install --git https://github.com/googleworkspace/cli --locked' },
          { title: 'Install gcloud CLI (for automated auth)', description: 'Debian/Ubuntu one-liner; other distros see cloud.google.com/sdk/docs/install.', command: 'curl https://sdk.cloud.google.com | bash && exec -l $SHELL' },
          { title: 'Automated setup via gcloud', description: 'Provisions the Cloud project, enables APIs, runs the OAuth flow.', command: 'gws auth setup' },
          { title: 'Verify auth', command: 'gws drive files list --params \'{"pageSize": 5}\'' },
        ],
        verify: 'gws --version',
      },
    ],
    docsUrl: 'https://github.com/googleworkspace/cli',
    shortUrl: null,
  },
  {
    name: 'Hugging Face CLI',
    emoji: '🤗',
    description: 'Download models and datasets, push repos, manage auth tokens, and run Hugging Face Hub ops from the terminal.',
    category: 'ML & Models',
    color: 'amber',
    status: 'Live',
    agentPrompt: '"Use hf to download meta-llama/Llama-3.2-1B-Instruct" · "Upload this model folder to my HF account" · "List files in this dataset repo"',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Prerequisite: Python 3.8+', description: 'Check with `python3 --version`. Install via Homebrew if missing.', command: 'brew install python' },
          { title: 'Install huggingface_hub with CLI extras', description: 'The `[cli]` extra installs the `hf` binary (replaces the old `huggingface-cli`).', command: 'pip install -U "huggingface_hub[cli]"' },
          { title: '(Alternative) Install via uv', description: 'Faster if you already use uv for Python envs.', command: 'uv tool install "huggingface_hub[cli]"' },
          { title: 'Log in with a user access token', description: 'Create a token at https://huggingface.co/settings/tokens (read + write scope). `hf auth login` prompts for the token and stores it in `~/.cache/huggingface/token`.', command: 'hf auth login' },
          { title: 'Verify auth', description: 'Returns your HF username + org memberships.', command: 'hf auth whoami' },
          { title: '(Optional) Download a model', description: 'Pulls the repo into the HF cache. Agents can reference it by repo_id afterward.', command: 'hf download meta-llama/Llama-3.2-1B-Instruct' },
        ],
        verify: 'hf --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Prerequisite: Python 3.8+', description: 'Install via winget if missing. Tick "Add python.exe to PATH" during interactive installs.', command: 'winget install Python.Python.3.12' },
          { title: 'Open a FRESH PowerShell window', description: 'PATH refresh. Required after Python install so `pip` resolves.' },
          { title: 'Install huggingface_hub with CLI extras', description: 'Installs the `hf` binary onto your Python Scripts PATH. Quotes are required in PowerShell for the bracket extra.', command: 'pip install -U "huggingface_hub[cli]"' },
          { title: 'Log in with a user access token', description: 'Generate a token at https://huggingface.co/settings/tokens (read + write scope). The command prompts for the token and stores it in %USERPROFILE%\\.cache\\huggingface\\token.', command: 'hf auth login' },
          { title: 'Verify auth', description: 'Returns your HF username + org memberships. 401 means re-run `hf auth login`.', command: 'hf auth whoami' },
          { title: '(Optional) Download a model', description: 'Cached under %USERPROFILE%\\.cache\\huggingface\\hub — agents resolve by repo_id after this.', command: 'hf download meta-llama/Llama-3.2-1B-Instruct' },
        ],
        note: 'If `hf` is not recognised after install, the Python Scripts dir is missing from PATH. Add `%USERPROFILE%\\AppData\\Local\\Programs\\Python\\Python3xx\\Scripts` and reopen the shell.',
        verify: 'hf --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Prerequisite: Python 3.8+ and pip', description: 'Debian/Ubuntu example. For other distros, use your package manager.', command: 'sudo apt update && sudo apt install -y python3 python3-pip' },
          { title: 'Install huggingface_hub with CLI extras', description: 'The `[cli]` extra installs the `hf` binary onto your user bin dir (usually `~/.local/bin`).', command: 'pip install -U "huggingface_hub[cli]"' },
          { title: '(Alternative) Install via pipx or uv', description: 'Isolated install — avoids polluting the system Python.', command: 'pipx install "huggingface_hub[cli]"' },
          { title: 'Log in with a user access token', description: 'Create a token at https://huggingface.co/settings/tokens (read + write scope). Stored in `~/.cache/huggingface/token`.', command: 'hf auth login' },
          { title: 'Verify auth', command: 'hf auth whoami' },
          { title: '(Optional) Download a model', command: 'hf download meta-llama/Llama-3.2-1B-Instruct' },
        ],
        verify: 'hf --version',
      },
    ],
    docsUrl: 'https://huggingface.co/docs/huggingface_hub/en/guides/cli',
    shortUrl: null,
  },
];

