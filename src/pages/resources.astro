        </a>
        <a href="#local-models" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[var(--color-card)] border-2 border-[var(--color-border)] text-sm font-bold text-[var(--color-text)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
