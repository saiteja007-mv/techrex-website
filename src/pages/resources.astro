---
import BaseLayout from '../layouts/BaseLayout.astro';
import resourcesData from '../data/resources.json';

const { categories } = resourcesData;

const iconPaths: Record<string, string> = {
  cpu: 'M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18',
  bot: 'M12 2a2 2 0 0 1 2 2c0 .74-.4 1.38-1 1.72V7h1a7 7 0 0 1 7 7H3a7 7 0 0 1 7-7h1V5.72A2 2 0 0 1 10 4a2 2 0 0 1 2-2zM3 16v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2H3zm6-4a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm6 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  chip: 'M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m16-6h-2m2 6h-2M7 19H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2m10 14h2a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 9h6v6H9V9z',
};

const categoryColors: Record<string, string> = {
  'Open Source Projects': 'text-primary',
  'Local AI Tools': 'text-secondary',
  'AI Assistants': 'text-purple-500',
  'Developer Tools': 'text-primary',
  'Hardware Guides': 'text-accent',
};

type ResourceItem = {
  name: string;
  url: string;
  altUrl?: string;
  altLabel?: string;
  description: string;
  tags: string[];
};
---
<BaseLayout
  title="My Projects — TechRex"
  description="Open source projects built by Saiteja Mothukuri (TechRex). Local AI memory layer, Blogger CLI skill for OpenClaw, and more."
>
  <!-- Header -->
  <section class="py-16 bg-bg dark:bg-bg-dark border-b border-border dark:border-border-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium mb-4">Open Source</span>
      <h1 class="font-heading font-bold text-4xl sm:text-5xl text-text dark:text-text-dark mb-3">My Projects</h1>
      <p class="text-muted dark:text-muted-dark text-base max-w-xl leading-relaxed">
        Projects I've built and open-sourced. More coming soon — including curated AI prompts.
      </p>
    </div>
  </section>

  <!-- Resource categories -->
  <section class="py-16 bg-surface dark:bg-surface-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {categories.map(category => (
        <div>
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-8">
            <div class={`w-10 h-10 rounded-xl bg-card dark:bg-card-dark border border-border dark:border-border-dark flex items-center justify-center ${categoryColors[category.name] ?? 'text-primary'}`}>
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPaths[category.icon] ?? iconPaths.code} />
              </svg>
            </div>
            <div>
              <h2 class={`font-heading font-bold text-xl text-text dark:text-text-dark`}>{category.name}</h2>
              <p class="text-xs text-muted dark:text-muted-dark">{category.items.length} resources</p>
            </div>
          </div>

          <!-- Resource cards grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {category.items.map((item: ResourceItem) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group p-5 rounded-xl bg-card dark:bg-card-dark border border-border dark:border-border-dark
                       hover:shadow-lg hover:shadow-black/10 dark:hover:shadow-black/40 hover:-translate-y-0.5
                       hover:border-primary/50 transition-all duration-200 cursor-pointer flex flex-col gap-3"
              >
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-heading font-semibold text-sm text-text dark:text-text-dark group-hover:text-primary transition-colors duration-200">
                    {item.name}
                  </h3>
                  <svg class="w-4 h-4 text-muted dark:text-muted-dark flex-shrink-0 group-hover:text-primary transition-colors duration-200 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </div>
                <p class="text-xs text-muted dark:text-muted-dark leading-relaxed flex-1">{item.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-auto">
                  {item.tags.map(tag => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-muted dark:text-muted-dark">
                      {tag}
                    </span>
                  ))}
                </div>
                {item.altUrl && (
                  <a
                    href={item.altUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation()"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-secondary hover:underline mt-1"
                  >
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Also on {item.altLabel}
                  </a>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-bg dark:bg-bg-dark border-t border-border dark:border-border-dark">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="font-heading font-bold text-2xl text-text dark:text-text-dark mb-3">See These Projects on GitHub</h2>
      <p class="text-sm text-muted dark:text-muted-dark mb-6">All projects are open source — fork, star, and contribute.</p>
      <a href="https://github.com/saiteja007-mv" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-white font-semibold text-sm hover:bg-primary-hover active:scale-95 transition-all duration-200 cursor-pointer shadow-lg shadow-primary/25">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
        View on GitHub
      </a>
    </div>
  </section>
</BaseLayout>
