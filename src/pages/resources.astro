---
import BaseLayout from '../layouts/BaseLayout.astro';
import channelInfo from '../data/channel-info.json';

const { socialLinks } = channelInfo;

type InstallStep = {
  title: string;
  description?: string;
  command?: string;
  note?: string;
};

type InstallTab = {
  os: 'macOS' | 'Windows' | 'Linux';
  steps: InstallStep[];
  note?: string;
  verify?: string;
};

type CliTool = {
  name: string;
  emoji: string;
  description: string;
  category: string;
  color: 'mint' | 'violet' | 'amber' | 'pink';
  status: 'Live' | 'Coming Soon';
  installTabs: InstallTab[];
  docsUrl: string;
  shortUrl: string | null;
};

const cliTools: CliTool[] = [
  {
    name: 'Vercel CLI',
    emoji: '▲',
    description: 'Deploy projects, manage env vars, and preview deployments from the terminal.',
    category: 'Deployment',
    color: 'mint',
    status: 'Live',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew', description: 'Requires Homebrew installed.', command: 'brew install vercel-cli' },
          { title: 'Authenticate', description: 'Log in to your Vercel account — opens a browser window.', command: 'vercel login' },
          { title: 'Link a project', description: 'Run this inside any project directory to link it.', command: 'vercel link' },
        ],
        verify: 'vercel --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install via npm', description: 'Requires Node.js. Use an elevated PowerShell if needed.', command: 'npm install -g vercel' },
          { title: 'Authenticate', command: 'vercel login' },
          { title: 'Link a project', command: 'vercel link' },
        ],
        verify: 'vercel --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Install via npm', description: 'Requires Node.js 16+.', command: 'npm install -g vercel' },
          { title: 'Authenticate', command: 'vercel login' },
          { title: 'Link a project', command: 'vercel link' },
        ],
        verify: 'vercel --version',
      },
    ],
    docsUrl: 'https://vercel.com/docs/cli',
    shortUrl: null,
  },
  {
    name: 'GitHub CLI',
    emoji: '🐙',
    description: 'Create PRs, manage issues, clone repos, and run workflows without leaving your terminal.',
    category: 'Version Control',
    color: 'violet',
    status: 'Live',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew', command: 'brew install gh' },
          { title: 'Authenticate', description: 'Follow the prompts to log in via browser or token.', command: 'gh auth login' },
        ],
        verify: 'gh --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install via winget', description: 'Run PowerShell as Administrator.', command: 'winget install --id GitHub.cli' },
          { title: 'Authenticate', command: 'gh auth login' },
        ],
        verify: 'gh --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Add the GitHub CLI keyring', command: 'curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg' },
          { title: 'Install the package', command: 'sudo apt update && sudo apt install gh' },
          { title: 'Authenticate', command: 'gh auth login' },
        ],
        verify: 'gh --version',
      },
    ],
    docsUrl: 'https://cli.github.com/',
    shortUrl: null,
  },
  {
    name: 'Supabase CLI',
    emoji: '⚡',
    description: 'Spin up local Supabase, run migrations, and deploy edge functions from your terminal.',
    category: 'Database',
    color: 'amber',
    status: 'Live',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew tap', command: 'brew install supabase/tap/supabase' },
          { title: 'Log in', description: 'Generates an access token for your account.', command: 'supabase login' },
          { title: 'Initialize a project', description: 'Creates a supabase/ folder with config.', command: 'supabase init' },
        ],
        verify: 'supabase --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install via Scoop', description: 'Requires Scoop package manager.', command: 'scoop install supabase' },
          { title: 'Log in', command: 'supabase login' },
          { title: 'Initialize a project', command: 'supabase init' },
        ],
        note: 'Do not install globally via npm — Supabase recommends Scoop on Windows.',
        verify: 'supabase --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Install via npm', command: 'npm install -g supabase' },
          { title: 'Log in', command: 'supabase login' },
          { title: 'Initialize a project', command: 'supabase init' },
        ],
        verify: 'supabase --version',
      },
    ],
    docsUrl: 'https://supabase.com/docs/reference/cli/introduction',
    shortUrl: null,
  },
  {
    name: 'AWS CLI',
    emoji: '☁️',
    description: 'Manage AWS services, configure credentials, and automate cloud infrastructure.',
    category: 'Cloud',
    color: 'pink',
    status: 'Coming Soon',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install via Homebrew', command: 'brew install awscli' },
          { title: 'Configure credentials', description: 'Enter your Access Key, Secret Key, region, and output format.', command: 'aws configure' },
        ],
        verify: 'aws --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install via winget', command: 'winget install --id Amazon.AWSCLI' },
          { title: 'Configure credentials', command: 'aws configure' },
        ],
        verify: 'aws --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Download the installer', command: 'curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"' },
          { title: 'Unzip and install', command: 'unzip awscliv2.zip && sudo ./aws/install' },
          { title: 'Configure credentials', command: 'aws configure' },
        ],
        verify: 'aws --version',
      },
    ],
    docsUrl: 'https://aws.amazon.com/cli/',
    shortUrl: null,
  },
  {
    name: 'Google Workspace CLI',
    emoji: '🟩',
    description: 'Official Google Workspace CLI for managing users, groups, and admin resources from the terminal.',
    category: 'Productivity',
    color: 'mint',
    status: 'Coming Soon',
    installTabs: [
      {
        os: 'macOS',
        steps: [
          { title: 'Install Go (prerequisite)', description: 'Google Workspace CLI is built with Go. Skip if you already have Go 1.21+.', command: 'brew install go' },
          { title: 'Clone the official repo', command: 'git clone https://github.com/googleworkspace/cli.git' },
          { title: 'Build and install the CLI', description: 'From the cloned directory:', command: 'cd cli && go install ./...' },
          { title: 'Authenticate with Google', description: 'Follow the interactive browser flow to authorize Workspace access.', command: 'gws auth login' },
        ],
        verify: 'gws --version',
      },
      {
        os: 'Windows',
        steps: [
          { title: 'Install Go (prerequisite)', description: 'Run in an elevated PowerShell.', command: 'winget install GoLang.Go' },
          { title: 'Clone the official repo', command: 'git clone https://github.com/googleworkspace/cli.git' },
          { title: 'Build and install', command: 'cd cli; go install ./...' },
          { title: 'Authenticate with Google', command: 'gws auth login' },
        ],
        note: 'Make sure %USERPROFILE%\\go\\bin is in your PATH so the gws binary is found.',
        verify: 'gws --version',
      },
      {
        os: 'Linux',
        steps: [
          { title: 'Install Go (prerequisite)', command: 'sudo apt install golang-go' },
          { title: 'Clone the official repo', command: 'git clone https://github.com/googleworkspace/cli.git' },
          { title: 'Build and install', command: 'cd cli && go install ./...' },
          { title: 'Authenticate with Google', command: 'gws auth login' },
        ],
        verify: 'gws --version',
      },
    ],
    docsUrl: 'https://github.com/googleworkspace/cli',
    shortUrl: null,
  },
];

const toSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const featuredProject = {
  name: 'IPL 2026 Predictor',
  description: 'An XGBoost-powered IPL match winner predictor trained on 18 seasons of historical data. Includes a Streamlit app with interactive team selection, impact-player logic, and live win probabilities.',
  githubUrl: 'https://github.com/saiteja007-mv/IPL-2026-Predictor',
  liveUrl: 'https://techrex-ipl-prediction.streamlit.app/',
  notebookUrl: 'https://www.kaggle.com/code/saitejave/ipl-2026-predictor',
  datasetUrl: 'https://www.kaggle.com/datasets/saitejave/ipl-data',
  tags: ['Machine Learning', 'XGBoost', 'Streamlit', 'Cricket Analytics'],
  color: 'pink' as const,
  status: 'Live',
  emoji: '🏏',
  language: 'Python',
};

const projects = [
  {
    name: 'Open WebUI Desktop',
    description: 'Electron desktop app for Open WebUI — pure black UI, venv installer, and system tray integration. Run your local AI chat interface as a native desktop app without touching the terminal every time.',
    githubUrl: 'https://github.com/saiteja007-mv/open-webui-desktop',
    clawUrl: null,
    liveUrl: null,
    tags: ['Electron', 'Desktop App', 'Open WebUI', 'Local AI', 'JavaScript'],
    color: 'amber' as const,
    status: 'Active',
    emoji: '🖥️',
  },
  {
    name: 'Local AI Memory',
    description: 'A local memory system for AI assistants that runs entirely on your own hardware. Store and retrieve context without cloud dependencies — full privacy, zero latency.',
    githubUrl: 'https://github.com/saiteja007-mv/local-ai-memory',
    clawUrl: null,
    liveUrl: null,
    tags: ['Local AI', 'Memory', 'Privacy', 'Open Source'],
    color: 'mint' as const,
    status: 'Active',
    emoji: '🧠',
  },
  {
    name: 'GBlog Skill',
    description: 'A Claude Code skill for generating and publishing blog posts directly to Google Blogger. Automate your blogging workflow with AI. Also available as a Claude skill on Clawhub.',
    githubUrl: 'https://github.com/saiteja007-mv/gblog-skill',
    clawUrl: 'https://clawhub.ai/saiteja007-mv/gblog',
    liveUrl: null,
    tags: ['Claude', 'Blogging', 'Automation', 'AI Skill'],
    color: 'violet' as const,
    status: 'Active',
    emoji: '✍️',
  },
];

const shadowMap = {
  mint: 'shadow-hard-mint',
  violet: 'shadow-hard-violet',
  pink: 'shadow-hard-pink',
  amber: 'shadow-hard-amber',
};

const accentMap = {
  mint: { bg: '#34D399', text: 'text-emerald-700', border: '#34D399' },
  violet: { bg: '#8B5CF6', text: 'text-violet-700', border: '#8B5CF6' },
  pink: { bg: '#F472B6', text: 'text-pink-700', border: '#F472B6' },
  amber: { bg: '#FBBF24', text: 'text-amber-700', border: '#FBBF24' },
};

const featuredAccent = accentMap[featuredProject.color];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://techrex.saitejamothukuri.com/" },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://techrex.saitejamothukuri.com/resources/" }
  ]
};

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://techrex.saitejamothukuri.com/resources/",
  "url": "https://techrex.saitejamothukuri.com/resources/",
  "name": "Projects & Resources — TechRex",
  "description": "Personal open-source projects by Saiteja Mothukuri — TechRex. Local AI memory, Claude skills, and developer automation tools.",
  "isPartOf": { "@id": "https://techrex.saitejamothukuri.com/#website" },
  "author": { "@id": "https://techrex.saitejamothukuri.com/#person" }
};
---
<BaseLayout
  title="Projects — TechRex"
  description="Personal open-source projects by Saiteja Mothukuri — TechRex. Local AI memory, Claude skills, and developer automation tools."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="py-20 bg-[var(--color-bg)] border-b-2 border-[var(--color-border)] relative overflow-hidden">
    <div class="absolute inset-0 pattern-dots opacity-[0.04] pointer-events-none"></div>
    <!-- Decorative shapes -->
    <div class="absolute top-10 right-16 w-10 h-10 rounded-full bg-primary/20 border-2 border-primary hidden lg:block"></div>
    <div class="absolute bottom-10 left-12 w-8 h-8 bg-[var(--color-mint)] border-2 border-[var(--color-border)] rotate-12 hidden lg:block" style="box-shadow: 3px 3px 0px 0px var(--color-border)"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-6 shadow-hard-sm">
        Open Source
      </span>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl text-[var(--color-text)] mb-4 tracking-tight">
        My Projects
      </h1>
      <p class="text-[var(--color-muted)] text-lg max-w-2xl leading-relaxed">
        Tools and skills I'm building in public. Everything open-source, everything practical.
      </p>
    </div>
  </section>

  <!-- Featured Project -->
  <section class="py-16 bg-[var(--color-surface)] border-b-2 border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold shadow-hard-sm"
              style={`color: ${featuredAccent.bg}`}>
          ★ Featured
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)]">Project Spotlight</h2>
      </div>

      <article class={`bg-[var(--color-card)] rounded-2xl border-2 border-[var(--color-border)] ${shadowMap[featuredProject.color]} p-8 flex flex-col lg:flex-row gap-8 hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200`}>
        <!-- Left: Icon + Meta -->
        <div class="flex-shrink-0 flex flex-col items-start gap-4">
          <div class="w-20 h-20 rounded-2xl border-2 border-[var(--color-border)] flex items-center justify-center text-4xl"
               style={`background: ${featuredAccent.bg}18; box-shadow: 4px 4px 0px 0px ${featuredAccent.border}`}>
            {featuredProject.emoji}
          </div>
          <div class="flex flex-col gap-2">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold border-2"
                  style={`color: ${featuredAccent.bg}; border-color: ${featuredAccent.border}; background: ${featuredAccent.bg}18`}>
              ● {featuredProject.status}
            </span>
            <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-[var(--color-muted)]">
              {featuredProject.language}
            </span>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="flex-1 flex flex-col gap-5">
          <div>
            <h3 class="font-heading font-extrabold text-2xl sm:text-3xl text-[var(--color-text)] leading-tight mb-3">
              {featuredProject.name}
            </h3>
            <p class="text-[var(--color-muted)] leading-relaxed text-base">
              {featuredProject.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            {featuredProject.tags.map(tag => (
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-[var(--color-muted)]">
                {tag}
              </span>
            ))}
          </div>

          <div class="mt-auto flex flex-wrap gap-3">
            <a
              href={featuredProject.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              View on GitHub
            </a>
            {featuredProject.liveUrl && (
              <a
                href={featuredProject.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold border-2 border-[var(--color-border)] bg-primary text-white shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3h7v7"/>
                  <path d="M10 14L21 3"/>
                  <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
                </svg>
                Open Live App
              </a>
            )}
            {featuredProject.notebookUrl && (
              <a
                href={featuredProject.notebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold border-2 border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm4.441 16.892c-2.102.144-6.784.144-8.883 0C5.282 16.736 5.017 15.622 5 12c.017-3.629.285-4.736 2.558-4.892 2.099-.144 6.782-.144 8.883 0C18.718 7.264 18.982 8.378 19 12c-.018 3.629-.285 4.736-2.559 4.892zM10 9.658l4.917 2.338L10 14.342V9.658z"/>
                </svg>
                Kaggle Notebook
              </a>
            )}
            {featuredProject.datasetUrl && (
              <a
                href={featuredProject.datasetUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold border-2 border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"/>
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                </svg>
                Kaggle Dataset
              </a>
            )}
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {projects.map((project) => {
          const accent = accentMap[project.color];
          const shadow = shadowMap[project.color];
          return (
            <article class={`bg-[var(--color-card)] rounded-2xl border-2 border-[var(--color-border)] ${shadow} p-7 flex flex-col gap-5 hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200`}>
              <!-- Header -->
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">{project.emoji}</span>
                  <div>
                    <h2 class="font-heading font-extrabold text-xl text-[var(--color-text)] leading-tight">{project.name}</h2>
                    <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded-full text-xs font-bold border-2"
                          style={`color: ${accent.bg}; border-color: ${accent.border}; background: ${accent.bg}18`}>
                      ● {project.status}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Description -->
              <p class="text-sm text-[var(--color-muted)] leading-relaxed flex-1">
                {project.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {project.tags.map(tag => (
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-[var(--color-muted)]">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-3 mt-auto flex-wrap">
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-xs font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
