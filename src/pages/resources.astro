  <script>
    function initCliCards() {
      let activeModal: HTMLElement | null = null;

      const closeModal = () => {
        if (!activeModal) return;
        activeModal.hidden = true;
        const card = activeModal.closest<HTMLElement>('.cli-card');
        const headerBtn = card?.querySelector<HTMLButtonElement>('[data-card-toggle]');
        headerBtn?.setAttribute('aria-expanded', 'false');
        if (card) card.dataset.expanded = 'false';
        activeModal = null;
        document.body.style.overflow = '';
      };

      const openModal = (modal: HTMLElement) => {
        if (activeModal && activeModal !== modal) closeModal();
        modal.hidden = false;
        activeModal = modal;
        const card = modal.closest<HTMLElement>('.cli-card');
        const headerBtn = card?.querySelector<HTMLButtonElement>('[data-card-toggle]');
        headerBtn?.setAttribute('aria-expanded', 'true');
        if (card) card.dataset.expanded = 'true';
        document.body.style.overflow = 'hidden';
      };

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && activeModal) closeModal();
      });

      document.querySelectorAll<HTMLElement>('.cli-card').forEach((card) => {
        const modal = card.querySelector<HTMLElement>('[data-cli-modal]');
        const headerBtn = card.querySelector<HTMLButtonElement>('[data-card-toggle]');
        const guideBtn = card.querySelector<HTMLButtonElement>('[data-card-toggle-btn]');

        if (!modal) return;

        const open = (e: Event) => { e.stopPropagation(); openModal(modal); };
        headerBtn?.addEventListener('click', open);
        guideBtn?.addEventListener('click', open);

        card.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('a')) return;
          if (target.closest('[data-cli-modal]')) return;
          if (target.closest('[data-card-toggle]')) return;
          if (target.closest('[data-card-toggle-btn]')) return;
          openModal(modal);
        });
        card.style.cursor = 'pointer';

        modal.querySelector<HTMLElement>('[data-cli-backdrop]')?.addEventListener('click', closeModal);
        modal.querySelector<HTMLButtonElement>('[data-cli-close]')?.addEventListener('click', closeModal);

        const tabBtns = modal.querySelectorAll<HTMLButtonElement>('[data-os-tab-btn]');
        const panes = modal.querySelectorAll<HTMLElement>('[data-os-pane]');
        tabBtns.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const idx = Number(btn.dataset.tabIdx);
            tabBtns.forEach((b, i) => {
              const active = i === idx;
              b.setAttribute('aria-selected', String(active));
              if (active) {
                b.classList.add('bg-[var(--color-text)]', 'text-[var(--color-bg)]', 'border-[var(--color-border)]');
                b.classList.remove('text-[var(--color-muted)]', 'border-transparent', 'bg-transparent');
              } else {
                b.classList.remove('bg-[var(--color-text)]', 'text-[var(--color-bg)]', 'border-[var(--color-border)]');
                b.classList.add('text-[var(--color-muted)]', 'border-transparent', 'bg-transparent');
              }
            });
            panes.forEach((p, i) => { p.hidden = i !== idx; });
          });
        });

        modal.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const codeEl = btn.parentElement?.querySelector('code');
            const cmd = codeEl?.textContent?.trim() || '';
            if (!cmd) return;
            try {
              await navigator.clipboard.writeText(cmd);
              const copyIcon = btn.querySelector<HTMLElement>('.copy-icon');
              const checkIcon = btn.querySelector<HTMLElement>('.check-icon');
              copyIcon?.classList.add('hidden');
              checkIcon?.classList.remove('hidden');
              setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                checkIcon?.classList.add('hidden');
              }, 1500);
            } catch {}
          });
        });
      });
    }

    initCliCards();
    document.addEventListener('astro:page-load', initCliCards);
  </script>
</BaseLayout>
