---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredProject = {
  name: 'IPL 2026 Predictor',
  description: 'An XGBoost-powered IPL match winner predictor trained on 18 seasons of historical data. Includes a Streamlit app with interactive team selection, impact-player logic, and live win probabilities.',
  githubUrl: 'https://github.com/saiteja007-mv/IPL-2026-Predictor',
  liveUrl: 'https://techrex-ipl-prediction.streamlit.app/',
  tags: ['Machine Learning', 'XGBoost', 'Streamlit', 'Cricket Analytics'],
  color: 'pink' as const,
  status: 'Live',
  emoji: '🏏',
  language: 'Python',
};

const projects = [
  {
    name: 'Open WebUI Desktop',
    description: 'Electron desktop app for Open WebUI — pure black UI, venv installer, and system tray integration. Run your local AI chat interface as a native desktop app without touching the terminal every time.',
    githubUrl: 'https://github.com/saiteja007-mv/open-webui-desktop',
    clawUrl: null,
    liveUrl: null,
    tags: ['Electron', 'Desktop App', 'Open WebUI', 'Local AI', 'JavaScript'],
    color: 'amber' as const,
    status: 'Active',
    emoji: '🖥️',
  },
  {
    name: 'Local AI Memory',
    description: 'A local memory system for AI assistants that runs entirely on your own hardware. Store and retrieve context without cloud dependencies — full privacy, zero latency.',
    githubUrl: 'https://github.com/saiteja007-mv/local-ai-memory',
    clawUrl: null,
    liveUrl: null,
    tags: ['Local AI', 'Memory', 'Privacy', 'Open Source'],
    color: 'mint' as const,
    status: 'Active',
    emoji: '🧠',
  },
  {
    name: 'GBlog Skill',
    description: 'A Claude Code skill for generating and publishing blog posts directly to Google Blogger. Automate your blogging workflow with AI. Also available as a Claude skill on Clawhub.',
    githubUrl: 'https://github.com/saiteja007-mv/gblog-skill',
    clawUrl: 'https://clawhub.ai/saiteja007-mv/gblog',
    liveUrl: null,
    tags: ['Claude', 'Blogging', 'Automation', 'AI Skill'],
    color: 'violet' as const,
    status: 'Active',
    emoji: '✍️',
  },
];

const shadowMap = {
  mint: 'shadow-hard-mint',
  violet: 'shadow-hard-violet',
  pink: 'shadow-hard-pink',
  amber: 'shadow-hard-amber',
};

const accentMap = {
  mint: { bg: '#34D399', text: 'text-emerald-700', border: '#34D399' },
  violet: { bg: '#8B5CF6', text: 'text-violet-700', border: '#8B5CF6' },
  pink: { bg: '#F472B6', text: 'text-pink-700', border: '#F472B6' },
  amber: { bg: '#FBBF24', text: 'text-amber-700', border: '#FBBF24' },
};

const featuredAccent = accentMap[featuredProject.color];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://techrex.saitejamothukuri.com/" },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://techrex.saitejamothukuri.com/resources/" }
  ]
};
---
<BaseLayout
  title="Projects — TechRex"
  description="Personal open-source projects by Saiteja Mothukuri — TechRex. Local AI memory, Claude skills, and developer automation tools."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="py-20 bg-[var(--color-bg)] border-b-2 border-[var(--color-border)] relative overflow-hidden">
    <div class="absolute inset-0 pattern-dots opacity-[0.04] pointer-events-none"></div>
    <!-- Decorative shapes -->
    <div class="absolute top-10 right-16 w-10 h-10 rounded-full bg-primary/20 border-2 border-primary hidden lg:block"></div>
    <div class="absolute bottom-10 left-12 w-8 h-8 bg-[var(--color-mint)] border-2 border-[var(--color-border)] rotate-12 hidden lg:block" style="box-shadow: 3px 3px 0px 0px var(--color-border)"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-6 shadow-hard-sm">
        Open Source
      </span>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl text-[var(--color-text)] mb-4 tracking-tight">
        My Projects
      </h1>
      <p class="text-[var(--color-muted)] text-lg max-w-2xl leading-relaxed">
        Tools and skills I'm building in public. Everything open-source, everything practical.
      </p>
    </div>
  </section>

  <!-- Featured Project -->
  <section class="py-16 bg-[var(--color-surface)] border-b-2 border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold shadow-hard-sm"
              style={`color: ${featuredAccent.bg}`}>
          ★ Featured
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)]">Project Spotlight</h2>
      </div>

      <article class={`bg-[var(--color-card)] rounded-2xl border-2 border-[var(--color-border)] ${shadowMap[featuredProject.color]} p-8 flex flex-col lg:flex-row gap-8 hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200`}>
        <!-- Left: Icon + Meta -->
        <div class="flex-shrink-0 flex flex-col items-start gap-4">
          <div class="w-20 h-20 rounded-2xl border-2 border-[var(--color-border)] flex items-center justify-center text-4xl"
               style={`background: ${featuredAccent.bg}18; box-shadow: 4px 4px 0px 0px ${featuredAccent.border}`}>
            {featuredProject.emoji}
          </div>
          <div class="flex flex-col gap-2">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold border-2"
                  style={`color: ${featuredAccent.bg}; border-color: ${featuredAccent.border}; background: ${featuredAccent.bg}18`}>
              ● {featuredProject.status}
            </span>
            <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-[var(--color-muted)]">
              {featuredProject.language}
            </span>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="flex-1 flex flex-col gap-5">
          <div>
            <h3 class="font-heading font-extrabold text-2xl sm:text-3xl text-[var(--color-text)] leading-tight mb-3">
              {featuredProject.name}
            </h3>
            <p class="text-[var(--color-muted)] leading-relaxed text-base">
              {featuredProject.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            {featuredProject.tags.map(tag => (
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-[var(--color-muted)]">
                {tag}
              </span>
            ))}
          </div>

          <div class="mt-auto flex flex-wrap gap-3">
            <a
              href={featuredProject.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              View on GitHub
            </a>
            {featuredProject.liveUrl && (
              <a
                href={featuredProject.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold border-2 border-[var(--color-border)] bg-primary text-white shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3h7v7"/>
                  <path d="M10 14L21 3"/>
                  <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
                </svg>
                Open Live App
              </a>
            )}
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {projects.map((project) => {
          const accent = accentMap[project.color];
          const shadow = shadowMap[project.color];
          return (
            <article class={`bg-[var(--color-card)] rounded-2xl border-2 border-[var(--color-border)] ${shadow} p-7 flex flex-col gap-5 hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200`}>
              <!-- Header -->
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl">{project.emoji}</span>
                  <div>
                    <h2 class="font-heading font-extrabold text-xl text-[var(--color-text)] leading-tight">{project.name}</h2>
                    <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 rounded-full text-xs font-bold border-2"
                          style={`color: ${accent.bg}; border-color: ${accent.border}; background: ${accent.bg}18`}>
                      ● {project.status}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Description -->
              <p class="text-sm text-[var(--color-muted)] leading-relaxed flex-1">
                {project.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {project.tags.map(tag => (
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-[var(--color-muted)]">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-3 mt-auto flex-wrap">
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-xs font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                  </svg>
                  View on GitHub
                </a>
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold border-2 border-[var(--color-border)] bg-primary text-white shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 3h7v7"/>
                      <path d="M10 14L21 3"/>
                      <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>
                    </svg>
                    Open Live App
                  </a>
                )}
                {project.clawUrl && (
                  <a
                    href={project.clawUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold border-2 border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    Use on Clawhub
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <!-- Coming Soon Banner -->
      <div class="rounded-2xl border-2 border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-8 text-center mb-16 relative overflow-hidden">
        <div class="absolute inset-0 pattern-dots opacity-[0.04] pointer-events-none"></div>
        <div class="relative z-10">
          <span class="text-3xl mb-3 block">🚀</span>
          <h3 class="font-heading font-extrabold text-xl text-[var(--color-text)] mb-2">More Projects Coming Soon</h3>
          <p class="text-sm text-[var(--color-muted)] max-w-md mx-auto">
            Building more tools and skills in public. Follow on GitHub to stay updated.
          </p>
          <a
            href="https://github.com/saiteja007-mv"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 mt-5 px-5 py-2.5 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            Follow on GitHub
          </a>
        </div>
      </div>

      <!-- AI Prompts Teaser -->
      <div class="rounded-2xl border-2 border-[var(--color-border)] bg-[var(--color-card)] p-8 shadow-hard-violet flex flex-col md:flex-row items-center gap-6">
        <div class="flex-shrink-0 w-16 h-16 rounded-2xl bg-primary/10 border-2 border-primary flex items-center justify-center text-3xl" style="box-shadow: 3px 3px 0px 0px #8B5CF6">
          ✨
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="font-heading font-extrabold text-lg text-[var(--color-text)] mb-1">Curated AI Prompts — Coming Soon</h3>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">
            A hand-picked collection of prompts for local AI, coding, content creation, and more. Stay tuned.
          </p>
        </div>
        <span class="px-4 py-2 rounded-full bg-primary/10 text-primary text-xs font-bold border-2 border-primary flex-shrink-0">
          In Progress
        </span>
      </div>

      <div class="mt-10 rounded-2xl border-2 border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-hard-sm">
        <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-4">
          Related pages
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)] mb-3">Use these resources alongside the channel guides</h2>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed max-w-2xl mb-6">
          Want walkthroughs for the tools listed here? Start with <a href="/videos/" class="font-semibold text-primary hover:text-primary-hover transition-colors">Videos</a>. Want the background on how these projects fit into the TechRex workflow? Read <a href="/about/" class="font-semibold text-primary hover:text-primary-hover transition-colors">About</a>.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/videos/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-white text-sm font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
            Go to videos
          </a>
          <a href="/about/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-bg)] text-[var(--color-text)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
            Read about TechRex
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
