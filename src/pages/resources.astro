            </div>
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border-2 border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-hard-sm">
        <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-4">
          Related pages
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)] mb-3">Use these resources alongside the channel guides</h2>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed max-w-2xl mb-6">
          Want walkthroughs for the tools listed here? Watch on the <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:text-primary-hover transition-colors">YouTube channel</a>. Want the background on how these projects fit into the TechRex workflow? Read <a href="/about/" class="font-semibold text-primary hover:text-primary-hover transition-colors">About</a>.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-white text-sm font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
            Watch on YouTube
          </a>
          <a href="/about/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-bg)] text-[var(--color-text)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
            Read about TechRex
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initCliCards() {
      let activeModal: HTMLElement | null = null;

      // Move all modals to document.body so fixed positioning is always viewport-relative
      document.querySelectorAll<HTMLElement>('[data-cli-modal]').forEach((modal) => {
        if (modal.parentElement !== document.body) document.body.appendChild(modal);
      });

      const closeModal = () => {
        if (!activeModal) return;
        activeModal.style.display = 'none';
        activeModal.hidden = true;
        activeModal = null;
        document.body.style.overflow = '';
      };

      const openModal = (modal: HTMLElement) => {
        if (activeModal && activeModal !== modal) closeModal();
        modal.hidden = false;
        modal.style.display = 'flex';
        activeModal = modal;
        document.body.style.overflow = 'hidden';
      };

      const openById = (slug: string) => {
        const modal = document.getElementById(`${slug}-details`);
        if (modal) openModal(modal);
      };

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && activeModal) closeModal();
      });

      // Bind open handlers to any element with data-cli-open (cards + buttons)
      document.querySelectorAll<HTMLElement>('[data-cli-open]').forEach((el) => {
        const slug = el.dataset.cliOpen;
        if (!slug) return;
        el.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          // Ignore clicks on anchors inside the card (Official docs / Watch Short)
          if (target.closest('a')) return;
          e.stopPropagation();
          openById(slug);
        });
        // Keyboard support for role=button cards
        if (el.getAttribute('role') === 'button') {
          el.addEventListener('keydown', (e) => {
            const ke = e as KeyboardEvent;
            if (ke.key === 'Enter' || ke.key === ' ') {
              ke.preventDefault();
              openById(slug);
            }
          });
        }
      });

      // Per-modal wiring: close + tabs + copy
      document.querySelectorAll<HTMLElement>('[data-cli-modal]').forEach((modal) => {
        modal.querySelector<HTMLElement>('[data-cli-backdrop]')?.addEventListener('click', closeModal);
        modal.querySelector<HTMLButtonElement>('[data-cli-close]')?.addEventListener('click', closeModal);

        const tabBtns = modal.querySelectorAll<HTMLButtonElement>('[data-os-tab-btn]');
        const panes = modal.querySelectorAll<HTMLElement>('[data-os-pane]');
        tabBtns.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const idx = Number(btn.dataset.tabIdx);
            tabBtns.forEach((b, i) => {
              const active = i === idx;
              b.setAttribute('aria-selected', String(active));
              if (active) {
                b.classList.add('bg-[var(--color-text)]', 'text-[var(--color-bg)]', 'border-[var(--color-border)]');
                b.classList.remove('text-[var(--color-muted)]', 'border-transparent', 'bg-transparent');
              } else {
                b.classList.remove('bg-[var(--color-text)]', 'text-[var(--color-bg)]', 'border-[var(--color-border)]');
                b.classList.add('text-[var(--color-muted)]', 'border-transparent', 'bg-transparent');
              }
            });
            panes.forEach((p, i) => { p.hidden = i !== idx; });
          });
        });

        modal.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const codeEl = btn.parentElement?.querySelector('code');
            const cmd = codeEl?.textContent?.trim() || '';
            if (!cmd) return;
            try {
              await navigator.clipboard.writeText(cmd);
              const copyIcon = btn.querySelector<HTMLElement>('.copy-icon');
              const checkIcon = btn.querySelector<HTMLElement>('.check-icon');
              copyIcon?.classList.add('hidden');
              checkIcon?.classList.remove('hidden');
              setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                checkIcon?.classList.add('hidden');
              }, 1500);
            } catch {}
          });
        });
      });
    }

    initCliCards();
    document.addEventListener('astro:page-load', initCliCards);

    // Claude Code Setup Bundle — Agent Prompt modal (view + copy)
    function initAgentPromptModal() {
      const modal = document.querySelector<HTMLElement>('[data-prompt-modal]');
      if (!modal || (modal as HTMLElement).dataset.wired === '1') return;
      (modal as HTMLElement).dataset.wired = '1';

      // Move modal to body so fixed positioning is always viewport-relative
      if (modal.parentElement !== document.body) document.body.appendChild(modal);

      const pre = modal.querySelector<HTMLElement>('[data-prompt-text]');
      let loaded = false;
      let cachedText = '';

      const loadPrompt = async () => {
        if (loaded) return;
        try {
          const res = await fetch('/claude-code-setup/agent-prompt.txt', { cache: 'no-cache' });
          if (!res.ok) throw new Error(String(res.status));
          cachedText = await res.text();
          if (pre) pre.textContent = cachedText;
          loaded = true;
        } catch {
          if (pre) pre.textContent = 'Unable to load prompt. Please download setup.md instead.';
        }
      };

      const open = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.documentElement.style.overflow = 'hidden';
        loadPrompt();
        modal.querySelector<HTMLButtonElement>('[data-prompt-close]')?.focus();
      };
      const close = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.documentElement.style.overflow = '';
      };

      document.querySelectorAll<HTMLButtonElement>('[data-prompt-open]').forEach((btn) => {
        btn.addEventListener('click', open);
      });
      modal.querySelectorAll<HTMLElement>('[data-prompt-close], [data-prompt-backdrop]').forEach((el) => {
        el.addEventListener('click', close);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
      });

      const copyBtn = modal.querySelector<HTMLButtonElement>('[data-prompt-copy]');
      copyBtn?.addEventListener('click', async () => {
        const text = cachedText || pre?.textContent || '';
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const copyIcon = copyBtn.querySelector<HTMLElement>('.copy-icon');
          const checkIcon = copyBtn.querySelector<HTMLElement>('.check-icon');
          const label = copyBtn.querySelector<HTMLElement>('.copy-label');
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          const prev = label?.textContent;
          if (label) label.textContent = 'Copied!';
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (label && prev) label.textContent = prev;
          }, 1800);
        } catch {}
      });
    }
    initAgentPromptModal();
    document.addEventListener('astro:page-load', initAgentPromptModal);

    // Claude Code Setup Bundle — Detailed-view modal
    function initBundleModal() {
      const modal = document.querySelector<HTMLElement>('[data-bundle-modal]');
      if (!modal || (modal as HTMLElement).dataset.wired === '1') return;
      (modal as HTMLElement).dataset.wired = '1';

      // Portal to body so fixed positioning is always viewport-relative
      if (modal.parentElement !== document.body) document.body.appendChild(modal);

      const openBtns = document.querySelectorAll<HTMLButtonElement>('[data-bundle-open]');
      const closeBtns = modal.querySelectorAll<HTMLElement>('[data-bundle-close], [data-bundle-backdrop]');

      const open = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.documentElement.style.overflow = 'hidden';
        // move focus to close button for a11y
        modal.querySelector<HTMLButtonElement>('[data-bundle-close]')?.focus();
      };
      const close = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.documentElement.style.overflow = '';
      };

      openBtns.forEach((btn) => btn.addEventListener('click', open));
      closeBtns.forEach((el) => el.addEventListener('click', close));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
      });
    }
    initBundleModal();
    document.addEventListener('astro:page-load', initBundleModal);

    // ============================================================
    // Local Models Setup Advisor
    // ============================================================
    function initLocalModels() {
      const root = document.querySelector<HTMLElement>('#local-models');
      if (!root || root.dataset.wired === '1') return;
      root.dataset.wired = '1';

      type Quant = {
        name: string;
        sizeGB: number;
        kvGB: number;
        visionGB: number;
        scratchGB: number;
        totalFitGB: number;
        minVramGB: number;
        partialOffloadRamGB: number;
        macUnifiedMinGB: number;
        file: string;
        downloadUrl: string;
        recommended?: boolean;
      };
      type MlxQuant = {
        quant: string;
        repo: string;
        repoUrl: string;
        sizeGB: number;
        kvGB: number;
        scratchGB: number;
        totalFitGB: number;
        minUnifiedGB: number;
        recommendedFor: string[];
      };
      type Arch = { numLayers: number; kvHeads: number; headDim: number; hasVision: boolean };
      type LocalModel = {
        id: string;
        name: string;
        alias: string;
        family: string;
        kind: 'moe' | 'dense';
        tier: 'cpu-only' | 'low-vram' | 'mid-vram' | 'high-vram';
        useCases: string[];
        license: string;
        ggufRepo: string;
        repoUrl: string;
        mmprojUrl: string | null;
        mmprojBytesEstimateGB: number;
        defaultLaunchContext: number;
        defaultLaunchFlags: { ctx: number; ctk: string; ctv: string; ngl: number; flashAttn: boolean; threads: number; batch: number; ubatch: number; jinja: boolean; reasoningFormat: string | null; host: string; port: number };
        arch: Arch;
        quants: Quant[];
        mlxQuants: MlxQuant[];
        mlx: { repos: Record<string, string>; recommendedQuants: Record<string, string>; defaultLaunchFlags: { ctx: number; host: string; port: number } };
      };

      const dataEl = document.getElementById('lm-data');
      if (!dataEl?.textContent) return;
      const allModels = (JSON.parse(dataEl.textContent) as { models: LocalModel[] }).models;

      // Constants — match scripts/fetch-models.mjs
      const CACHE_BYTES: Record<string, number> = { f32: 4, f16: 2, bf16: 2, q8_0: 1, q5_0: 0.625, q4_0: 0.5 };
      const SCRATCH_GB = 0.5;
      const MLX_SCRATCH_GB = 1.0;

      const inputCard = root.querySelector<HTMLElement>('[data-lm-input-card]')!;
      const paneWin = inputCard.querySelector<HTMLElement>('[data-lm-pane-win]')!;
      const paneMac = inputCard.querySelector<HTMLElement>('[data-lm-pane-mac]')!;
      const ramSlider = inputCard.querySelector<HTMLInputElement>('[data-lm-ram]')!;
      const vramSlider = inputCard.querySelector<HTMLInputElement>('[data-lm-vram]')!;
      const unifiedSlider = inputCard.querySelector<HTMLInputElement>('[data-lm-unified]')!;
      const ramOut = inputCard.querySelector<HTMLElement>('[data-lm-ram-out]')!;
      const vramOut = inputCard.querySelector<HTMLElement>('[data-lm-vram-out]')!;
      const unifiedOut = inputCard.querySelector<HTMLElement>('[data-lm-unified-out]')!;
      const tierBadge = inputCard.querySelector<HTMLElement>('[data-lm-tier-badge]')!;
      const tierSummary = inputCard.querySelector<HTMLElement>('[data-lm-tier-summary]')!;

      const ctxSlider = root.querySelector<HTMLInputElement>('[data-lm-ctx]')!;
      const ctxOut = root.querySelector<HTMLElement>('[data-lm-ctx-out]')!;

      const recName = root.querySelector<HTMLElement>('[data-lm-rec-name]')!;
      const recQuant = root.querySelector<HTMLElement>('[data-lm-rec-quant]')!;
      const recRuntime = root.querySelector<HTMLElement>('[data-lm-rec-runtime]')!;
      const recLicense = root.querySelector<HTMLElement>('[data-lm-rec-license]')!;
      const recFits = root.querySelector<HTMLElement>('[data-lm-rec-fits]')!;
      const recRepo = root.querySelector<HTMLAnchorElement>('[data-lm-rec-repo]')!;
      const recWorkloads = root.querySelector<HTMLElement>('[data-lm-rec-workloads]')!;
      const aliasOut = root.querySelector<HTMLElement>('[data-lm-alias]')!;

      const WORKLOAD_ICONS: Record<string, string> = {
        coding: '⌨️',
        chat: '💬',
        agentic: '🤖',
        vision: '👁️'
      };

      const segModel = root.querySelector<HTMLElement>('[data-lm-seg-model]')!;
      const segKv = root.querySelector<HTMLElement>('[data-lm-seg-kv]')!;
      const segVision = root.querySelector<HTMLElement>('[data-lm-seg-vision]')!;
      const segScratch = root.querySelector<HTMLElement>('[data-lm-seg-scratch]')!;
      const totalOut = root.querySelector<HTMLElement>('[data-lm-total-out]')!;
      const budgetOut = root.querySelector<HTMLElement>('[data-lm-budget-out]')!;
      const barModel = root.querySelector<HTMLElement>('[data-lm-bar-model]')!;
      const barKv = root.querySelector<HTMLElement>('[data-lm-bar-kv]')!;
      const barVision = root.querySelector<HTMLElement>('[data-lm-bar-vision]')!;
      const barScratch = root.querySelector<HTMLElement>('[data-lm-bar-scratch]')!;

      const setupModal = document.querySelector<HTMLElement>('#local-models-setup-details')!;
      const modalTitle = setupModal.querySelector<HTMLElement>('[data-lm-modal-title]')!;
      const snipWinDownload = setupModal.querySelector<HTMLElement>('[data-lm-snippet="win-download"]')!;
      const snipWinLaunch = setupModal.querySelector<HTMLElement>('[data-lm-snippet="win-launch"]')!;
      const snipLinDownload = setupModal.querySelector<HTMLElement>('[data-lm-snippet="linux-download"]')!;
      const snipLinLaunch = setupModal.querySelector<HTMLElement>('[data-lm-snippet="linux-launch"]')!;
      const snipMacDownload = setupModal.querySelector<HTMLElement>('[data-lm-snippet="mac-download"]')!;
      const snipMacLaunch = setupModal.querySelector<HTMLElement>('[data-lm-snippet="mac-launch"]')!;

      const state = {
        os: 'win-linux' as 'win-linux' | 'macos',
        ramGB: 32,
        vramGB: 12,
        unifiedGB: 32,
        useCases: new Set<string>(['coding']),
        ctxOverride: null as number | null
      };

      function kvCacheGB(arch: Arch, cacheType: string, ctx: number) {
        const bytes = CACHE_BYTES[cacheType] ?? CACHE_BYTES.f16;
        return (2 * arch.numLayers * arch.kvHeads * arch.headDim * ctx * bytes) / 1e9;
      }

      function detectTier(): string {
        if (state.os === 'macos') {
          if (state.unifiedGB <= 12) return 'mac-8gb';
          if (state.unifiedGB <= 20) return 'mac-16gb';
          if (state.unifiedGB <= 40) return 'mac-32gb';
          if (state.unifiedGB <= 80) return 'mac-64gb';
          return 'mac-128gb';
        }
        if (state.vramGB < 4) return 'cpu-only';
        if (state.vramGB < 10) return 'low-vram';
        if (state.vramGB < 20) return 'mid-vram';
        return 'high-vram';
      }

      const TIER_ORDER = ['cpu-only', 'low-vram', 'mid-vram', 'high-vram'];

      type Pick = {
        model: LocalModel;
        runtime: 'llamacpp' | 'mlx';
        ctx: number;
        ggufQuant?: Quant;
        mlxQuant?: MlxQuant;
        breakdown: { sizeGB: number; kvGB: number; visionGB: number; scratchGB: number; totalGB: number; budgetGB: number };
        fits: boolean;
      };

      // Score a model against the selected workloads. Higher = better match.
      // Use cases declared on each model (m.useCases) get +10. Vision matches the
      // hasVision flag (so we don't promote non-vision models when the user wants vision).
      // Agentic gives MoE a small bump. We do NOT hard-filter — if the highest-scoring
      // model doesn't fit, the engine falls back to the next best fit, with a note.
      function scoreModel(m: LocalModel): number {
        let score = 0;
        for (const uc of state.useCases) {
          if (uc === 'vision') {
            if (m.arch.hasVision) score += 30;  // strong signal — only 2 models qualify
            continue;
          }
          if (m.useCases.includes(uc)) score += 10;
          if (uc === 'agentic' && m.kind === 'moe') score += 5;
        }
        return score;
      }

      function rankCandidates(models: LocalModel[], maxSizeOf: (m: LocalModel) => number): LocalModel[] {
        return [...models].sort((a, b) => {
          const sa = scoreModel(a);
          const sb = scoreModel(b);
          if (sa !== sb) return sb - sa;
          // Same workload score: prefer the bigger model (more params = more capable).
          return maxSizeOf(b) - maxSizeOf(a);
        });
      }

      // List the workloads the chosen model actually covers, for the UI tags.
      function matchedWorkloads(m: LocalModel): string[] {
        const matches: string[] = [];
        for (const uc of state.useCases) {
          if (uc === 'vision' && m.arch.hasVision) matches.push(uc);
          else if (uc !== 'vision' && m.useCases.includes(uc)) matches.push(uc);
        }
        return matches;
      }
      function missedWorkloads(m: LocalModel): string[] {
        const missed: string[] = [];
        for (const uc of state.useCases) {
          if (uc === 'vision' && !m.arch.hasVision) missed.push(uc);
          else if (uc !== 'vision' && !m.useCases.includes(uc)) missed.push(uc);
        }
        return missed;
      }

      function pickMacOS(): Pick {
        const tier = detectTier();
        const budget = 0.7 * state.unifiedGB;
        // Rank by workload-match score then by max quant size. No hard-filtering on vision —
        // if the best-scoring model doesn't fit, we fall through to the next ranked one.
        const candidates = rankCandidates(allModels, (m) => Math.max(...m.mlxQuants.map((q) => q.sizeGB)));
        for (const model of candidates) {
          const ctx = state.ctxOverride ?? model.mlx.defaultLaunchFlags.ctx;
          const kv = kvCacheGB(model.arch, 'f16', ctx);
          // Pick the LARGEST MLX quant that fits unified-memory budget.
          const sorted = [...model.mlxQuants].sort((a, b) => b.sizeGB - a.sizeGB);
          for (const q of sorted) {
            const total = q.sizeGB + kv + MLX_SCRATCH_GB;
            if (total <= budget) {
              return {
                model, runtime: 'mlx', ctx, mlxQuant: q,
                breakdown: { sizeGB: q.sizeGB, kvGB: kv, visionGB: 0, scratchGB: MLX_SCRATCH_GB, totalGB: total, budgetGB: budget },
                fits: true
              };
            }
          }
        }
        // Nothing fits — show smallest and flag
        const m = allModels[0];
        const q = m.mlxQuants[0];
        const ctx = state.ctxOverride ?? m.mlx.defaultLaunchFlags.ctx;
        const kv = kvCacheGB(m.arch, 'f16', ctx);
        const total = q.sizeGB + kv + MLX_SCRATCH_GB;
        return {
          model: m, runtime: 'mlx', ctx, mlxQuant: q,
          breakdown: { sizeGB: q.sizeGB, kvGB: kv, visionGB: 0, scratchGB: MLX_SCRATCH_GB, totalGB: total, budgetGB: budget },
          fits: total <= budget
        };
      }

      function pickWinLinux(): Pick {
        const tier = detectTier();
        const userTierIdx = TIER_ORDER.indexOf(tier);
        // Budget = VRAM if any GPU; else fall back to RAM (CPU-only)
        const budget = state.vramGB >= 4 ? state.vramGB : state.ramGB;
        // Filter models to tiers user can run
        // Tier filter only — keep all useCase combinations as soft preferences via scoring.
        let candidates = allModels.filter((m) => TIER_ORDER.indexOf(m.tier) <= userTierIdx);
        candidates = rankCandidates(candidates, (m) => Math.max(...m.quants.map((q) => q.sizeGB)));

        for (const model of candidates) {
          const ctx = state.ctxOverride ?? model.defaultLaunchFlags.ctx;
          const kv = kvCacheGB(model.arch, model.defaultLaunchFlags.ctk, ctx);
          // Only count mmproj when the user actually wants vision — llama-server lazy-loads it
          // until the first image arrives, so ignoring it for text-only matches real-world VRAM use.
          const visionGB = model.arch.hasVision && state.useCases.has('vision') ? model.mmprojBytesEstimateGB : 0;
          // Pick the LARGEST quant that fits. Bigger quant = better quality, and we already
          // sorted candidates by max-size desc, so the first fit is the best fit.
          const sorted = [...model.quants].sort((a, b) => b.sizeGB - a.sizeGB);
          for (const q of sorted) {
            const total = q.sizeGB + kv + visionGB + SCRATCH_GB;
            if (total <= budget) {
              return {
                model, runtime: 'llamacpp', ctx, ggufQuant: q,
                breakdown: { sizeGB: q.sizeGB, kvGB: kv, visionGB, scratchGB: SCRATCH_GB, totalGB: total, budgetGB: budget },
                fits: true
              };
            }
          }
        }
        // No fit — show the smallest model+quant with the not-fits flag
        const m = allModels[0];
        const q = m.quants[0];
        const ctx = state.ctxOverride ?? m.defaultLaunchFlags.ctx;
        const kv = kvCacheGB(m.arch, m.defaultLaunchFlags.ctk, ctx);
        const visionGB = m.arch.hasVision ? m.mmprojBytesEstimateGB : 0;
        const total = q.sizeGB + kv + visionGB + SCRATCH_GB;
        return {
          model: m, runtime: 'llamacpp', ctx, ggufQuant: q,
          breakdown: { sizeGB: q.sizeGB, kvGB: kv, visionGB, scratchGB: SCRATCH_GB, totalGB: total, budgetGB: budget },
          fits: total <= budget
        };
      }

      function fmt(n: number) { return (Math.round(n * 100) / 100).toFixed(2); }

      function render() {
        const tier = detectTier();
        tierBadge.textContent = tier;
        tierSummary.textContent = state.os === 'macos'
          ? `${state.unifiedGB} GB unified memory`
          : `${state.ramGB} GB RAM + ${state.vramGB} GB VRAM`;

        const pick = state.os === 'macos' ? pickMacOS() : pickWinLinux();
        const { model, runtime, ctx, breakdown, fits } = pick;

        // Slider stays fixed at 2k–1M so users can stress-test any context length.
        // Only reset the value when the user hasn't manually overridden it.
        if (state.ctxOverride === null) {
          const defaultCtx = runtime === 'mlx' ? model.mlx.defaultLaunchFlags.ctx : model.defaultLaunchFlags.ctx;
          ctxSlider.value = String(defaultCtx);
        }
        ctxOut.textContent = String(ctx);

        // Recommendation card
        recName.textContent = model.name;
        const quantLabel = pick.ggufQuant
          ? `${pick.ggufQuant.name} · ${fmt(pick.ggufQuant.sizeGB)} GB`
          : `${pick.mlxQuant!.quant} · ${fmt(pick.mlxQuant!.sizeGB)} GB`;
        recQuant.textContent = quantLabel;
        recRuntime.textContent = runtime === 'mlx' ? 'MLX' : 'llama.cpp';
        recLicense.textContent = model.license;
        if (fits) {
          recFits.textContent = '✓ Fits';
          recFits.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 border-2 border-emerald-500/40 text-[11px] font-bold text-emerald-700 dark:text-emerald-400';
          recFits.setAttribute('data-lm-rec-fits', '');
        } else {
          recFits.textContent = '⚠ Too tight — reduce ctx';
          recFits.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 border-2 border-amber-500/40 text-[11px] font-bold text-amber-700 dark:text-amber-400';
          recFits.setAttribute('data-lm-rec-fits', '');
        }
        aliasOut.textContent = model.alias;
        recRepo.href = runtime === 'mlx' ? pick.mlxQuant!.repoUrl : model.repoUrl;

        // Matched/missed workload tags
        recWorkloads.innerHTML = '';
        if (state.useCases.size > 0) {
          const matched = matchedWorkloads(model);
          const missed = missedWorkloads(model);
          for (const uc of matched) {
            const span = document.createElement('span');
            span.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/40 text-[10px] font-bold text-emerald-700 dark:text-emerald-400';
            span.textContent = `${WORKLOAD_ICONS[uc] || ''} ${uc}`;
            recWorkloads.appendChild(span);
          }
          for (const uc of missed) {
            const span = document.createElement('span');
            span.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)] text-[10px] font-semibold text-[var(--color-muted)] line-through';
            span.title = uc === 'vision' ? 'This model has no vision adapter — pick Qwen3.6 series for image input.' : `This model is not optimized for ${uc} workloads.`;
            span.textContent = `${WORKLOAD_ICONS[uc] || ''} ${uc}`;
            recWorkloads.appendChild(span);
          }
          if (missed.length > 0) {
            const note = document.createElement('span');
            note.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/40 text-[10px] font-bold text-amber-700 dark:text-amber-400';
            note.textContent = `↳ best fit for your rig — bigger model needed for ${missed.join(', ')}`;
            recWorkloads.appendChild(note);
          }
        }

        // Breakdown
        segModel.textContent = `${fmt(breakdown.sizeGB)} GB`;
        segKv.textContent = `${fmt(breakdown.kvGB)} GB`;
        segVision.textContent = `${fmt(breakdown.visionGB)} GB`;
        segScratch.textContent = `${fmt(breakdown.scratchGB)} GB`;
        totalOut.textContent = fmt(breakdown.totalGB);
        budgetOut.textContent = String(breakdown.budgetGB);

        const denom = Math.max(breakdown.totalGB, breakdown.budgetGB);
        barModel.style.width = `${(breakdown.sizeGB / denom) * 100}%`;
        barKv.style.width = `${(breakdown.kvGB / denom) * 100}%`;
        barVision.style.width = `${(breakdown.visionGB / denom) * 100}%`;
        barScratch.style.width = `${(breakdown.scratchGB / denom) * 100}%`;

        // Modal title
        modalTitle.textContent = model.name;

        // Setup snippets — only the ones for the active runtime get fresh values; the others stay generic
        if (runtime === 'llamacpp' && pick.ggufQuant) {
          const gguf = pick.ggufQuant;
          const repoShort = model.ggufRepo;
          const fileName = gguf.file;
          const mmproj = model.arch.hasVision ? ' mmproj-BF16.gguf' : '';
          const flags = model.defaultLaunchFlags;
          const fa = flags.flashAttn ? '--flash-attn on' : '';
          const reasoning = flags.reasoningFormat ? `--reasoning-format ${flags.reasoningFormat}` : '';
          const mmprojArg = model.arch.hasVision ? ' --mmproj $mmproj' : '';
          const mmprojArgBash = model.arch.hasVision ? ' --mmproj $MMPROJ' : '';
          const jinja = flags.jinja ? '--jinja' : '';

          snipWinDownload.textContent = `huggingface-cli download ${repoShort} ${fileName}${mmproj}`;
          snipLinDownload.textContent = `huggingface-cli download ${repoShort} ${fileName}${mmproj}`;
          snipMacDownload.textContent = `huggingface-cli download ${repoShort} ${fileName}${mmproj}`;

          const winLaunch = `$model  = "$env:USERPROFILE\\.cache\\huggingface\\hub\\models--${repoShort.replace('/', '--')}\\snapshots\\*\\${fileName}"
${model.arch.hasVision ? `$mmproj = "$env:USERPROFILE\\.cache\\huggingface\\hub\\models--${repoShort.replace('/', '--')}\\snapshots\\*\\mmproj-BF16.gguf"\n` : ''}$llama  = "$env:USERPROFILE\\.unsloth\\llama.cpp\\build\\bin\\Release\\llama-server.exe"
& $llama -m $model${mmprojArg} --alias ${model.alias} \`
  -ngl ${flags.ngl} -c ${ctx} ${fa} -ctk ${flags.ctk} -ctv ${flags.ctv} \`
  -t ${flags.threads} -b ${flags.batch} -ub ${flags.ubatch} ${jinja} ${reasoning} \`
  --host ${flags.host} --port ${flags.port}`;
          snipWinLaunch.textContent = winLaunch;

          const linLaunch = `MODEL=~/.cache/huggingface/hub/models--${repoShort.replace('/', '--')}/snapshots/*/${fileName}
${model.arch.hasVision ? `MMPROJ=~/.cache/huggingface/hub/models--${repoShort.replace('/', '--')}/snapshots/*/mmproj-BF16.gguf\n` : ''}~/llama.cpp/build/bin/llama-server -m $MODEL${mmprojArgBash} --alias ${model.alias} \\
  -ngl ${flags.ngl} -c ${ctx} ${fa} -ctk ${flags.ctk} -ctv ${flags.ctv} \\
  -t ${flags.threads} -b ${flags.batch} -ub ${flags.ubatch} ${jinja} ${reasoning} \\
  --host ${flags.host} --port ${flags.port}`;
          snipLinLaunch.textContent = linLaunch;
        }

        // macOS pane always shows MLX, regardless of which OS the user picked.
        // Pick the right MLX repo for the current model + tier.
        const macTier = state.os === 'macos' ? detectTier() : 'mac-32gb';
        const mlxRecName = model.mlx.recommendedQuants?.[macTier] || Object.keys(model.mlx.repos)[0];
        const mlxRepo = model.mlx.repos[mlxRecName];
        const mlxCtx = state.os === 'macos' ? ctx : model.mlx.defaultLaunchFlags.ctx;
        snipMacDownload.textContent = `huggingface-cli download ${mlxRepo}`;
        snipMacLaunch.textContent = `mlx_lm.server --model ${mlxRepo} --host 0.0.0.0 --port ${model.mlx.defaultLaunchFlags.port}`;
      }

      // Wire OS toggle
      inputCard.querySelectorAll<HTMLButtonElement>('[data-lm-os]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const os = btn.dataset.lmOs as 'win-linux' | 'macos';
          state.os = os;
          state.ctxOverride = null;
          inputCard.querySelectorAll<HTMLButtonElement>('[data-lm-os]').forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-selected', String(active));
            if (active) {
              b.classList.add('bg-[var(--color-text)]', 'text-[var(--color-bg)]');
              b.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-bg)]');
            } else {
              b.classList.remove('bg-[var(--color-text)]', 'text-[var(--color-bg)]');
              b.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-bg)]');
            }
          });
          paneWin.hidden = os !== 'win-linux';
          paneMac.hidden = os !== 'macos';
          // Auto-jump the modal to the matching tab
          const tabIdx = os === 'macos' ? 2 : 0;
          const tabBtn = setupModal.querySelector<HTMLButtonElement>(`[data-os-tab-btn][data-tab-idx="${tabIdx}"]`);
          tabBtn?.click();
          render();
        });
      });

      // Wire sliders
      ramSlider.addEventListener('input', () => { state.ramGB = Number(ramSlider.value); ramOut.textContent = ramSlider.value; render(); });
      vramSlider.addEventListener('input', () => { state.vramGB = Number(vramSlider.value); vramOut.textContent = vramSlider.value; render(); });
      unifiedSlider.addEventListener('input', () => { state.unifiedGB = Number(unifiedSlider.value); unifiedOut.textContent = unifiedSlider.value; render(); });
      ctxSlider.addEventListener('input', () => { state.ctxOverride = Number(ctxSlider.value); ctxOut.textContent = ctxSlider.value; render(); });

      // Wire use-case chips
      inputCard.querySelectorAll<HTMLButtonElement>('[data-lm-usecase]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const uc = btn.dataset.lmUsecase!;
          if (state.useCases.has(uc)) state.useCases.delete(uc); else state.useCases.add(uc);
          const active = state.useCases.has(uc);
          btn.setAttribute('aria-pressed', String(active));
          if (active) {
            btn.classList.add('bg-[var(--color-text)]', 'text-[var(--color-bg)]', 'shadow-hard-sm');
            btn.classList.remove('bg-[var(--color-surface)]', 'text-[var(--color-muted)]');
          } else {
            btn.classList.remove('bg-[var(--color-text)]', 'text-[var(--color-bg)]', 'shadow-hard-sm');
            btn.classList.add('bg-[var(--color-surface)]', 'text-[var(--color-muted)]');
          }
          state.ctxOverride = null;
          render();
        });
      });

      render();
    }

    initLocalModels();
    document.addEventListener('astro:page-load', initLocalModels);
  </script>
</BaseLayout>
