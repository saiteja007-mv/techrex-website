---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoGrid from '../components/VideoGrid.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import MorphingText from '../components/MorphingText.astro';
import { getCollection } from 'astro:content';

const allVideos = await getCollection('videos');
const sortedVideos = allVideos
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map(v => v.data);
const latestVideos = sortedVideos.slice(0, 6);

const categories = [
  { name: 'Local AI', desc: 'Run AI models on your own hardware', count: allVideos.filter(v => v.data.category === 'Local AI').length },
  { name: 'AI Tools', desc: 'Best tools to supercharge your workflow', count: allVideos.filter(v => v.data.category === 'AI Tools').length },
  { name: 'AI Assistants', desc: 'Reviews and tutorials on AI agents', count: allVideos.filter(v => v.data.category === 'AI Assistants').length },
  { name: 'Hardware', desc: 'GPU guides for AI workloads', count: allVideos.filter(v => v.data.category === 'Hardware').length },
  { name: 'About', desc: 'Channel intro and background', count: allVideos.filter(v => v.data.category === 'About').length },
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "TechRex",
  "url": "https://techrex.saitejamothukuri.com",
  "description": "AI tools, local models, developer workflows and hardware guides.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://techrex.saitejamothukuri.com/videos?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Saiteja Mothukuri",
  "url": "https://saitejamothukuri.com",
  "sameAs": [
    "https://www.youtube.com/@The_TechRex",
    "https://linkedin.com/in/venkatasaitejam",
    "https://github.com/saiteja007-mv"
  ]
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TechRex",
  "url": "https://techrex.saitejamothukuri.com",
  "logo": "https://techrex.saitejamothukuri.com/favicon.svg",
  "description": "AI tools, local models, developer workflows and hardware guides.",
  "founder": { "@type": "Person", "name": "Saiteja Mothukuri" },
  "sameAs": [
    "https://www.youtube.com/@The_TechRex",
    "https://linkedin.com/in/venkatasaitejam",
    "https://github.com/saiteja007-mv"
  ]
};

const siteNavigationSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "TechRex Site Navigation",
  "itemListElement": [
    {
      "@type": "SiteLinksSearchBox",
      "url": "https://techrex.saitejamothukuri.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://techrex.saitejamothukuri.com/videos?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ]
};

const navLinksSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://techrex.saitejamothukuri.com/#website",
  "url": "https://techrex.saitejamothukuri.com",
  "name": "TechRex",
  "isPartOf": { "@id": "https://techrex.saitejamothukuri.com/#website" },
  "about": { "@type": "Thing", "name": "AI Tools and Local AI Models" },
  "hasPart": [
    {
      "@type": "WebPage",
      "name": "Videos",
      "url": "https://techrex.saitejamothukuri.com/videos",
      "description": "AI tools, local models, and hardware tutorial videos"
    },
    {
      "@type": "WebPage",
      "name": "About",
      "url": "https://techrex.saitejamothukuri.com/about",
      "description": "About TechRex and the REX Method"
    },
    {
      "@type": "WebPage",
      "name": "Resources",
      "url": "https://techrex.saitejamothukuri.com/resources",
      "description": "Curated AI tools and resources"
    },
    {
      "@type": "WebPage",
      "name": "Blog",
      "url": "https://techrex.saitejamothukuri.com/blog",
      "description": "Articles on AI, local models and developer workflows"
    }
  ]
};
---
<BaseLayout
  title="TechRex — Learn. Build. Launch."
  description="AI tools, local models, developer workflows and hardware guides. Learn to build and launch with the latest AI technology."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(navLinksSchema)} />
  </Fragment>
  <!-- Hero -->
  <Hero />

  <!-- Latest Videos -->
  <section class="py-20 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-[var(--color-text)]">
            Recent Videos
          </h2>
        </div>
        <a
          href="/videos"
          class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-hover transition-colors duration-150 cursor-pointer"
        >
          View all
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <VideoGrid videos={latestVideos} columns={3} />

      <!-- Mobile view all -->
      <div class="mt-8 text-center sm:hidden">
        <a href="/videos" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg border border-[var(--color-border)] text-sm font-medium text-[var(--color-text)] hover:border-primary hover:text-primary transition-colors duration-150 cursor-pointer">
          View all videos
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20 bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="font-heading font-bold text-3xl sm:text-4xl text-[var(--color-text)]">
          Explore Categories
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <a
            href={`/videos#${cat.name.toLowerCase().replace(/\s+/g, '-')}`}
            class="bg-[var(--color-card)] border border-[var(--color-border)] rounded-lg p-5
                   hover:border-primary/50 hover:shadow-sm transition-all duration-150 cursor-pointer"
          >
            <p class="font-bold text-2xl text-primary mb-1">{cat.count}</p>
            <h3 class="font-semibold text-sm text-[var(--color-text)] mb-1">{cat.name}</h3>
            <p class="text-xs text-[var(--color-muted)] leading-relaxed">{cat.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Resources Callout -->
  <section class="py-20 bg-[var(--color-bg)] border-t-2 border-[var(--color-border)] overflow-hidden">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">

      <!-- Eyebrow -->
      <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-6 shadow-hard-sm">
        👀 Psst — over here
      </span>

      <!-- Funny headline -->
      <p class="font-heading font-extrabold text-2xl sm:text-3xl text-[var(--color-text)] mb-3 leading-snug">
        Warning: The Resources page contains<br class="hidden sm:block" />
        <span class="text-primary">dangerously cool projects.</span>
      </p>
      <p class="text-[var(--color-muted)] text-base mb-8 max-w-xl mx-auto">
        Side effects include staying up till 3 AM, accidentally learning Electron, and building a desktop app you never planned.
        Don't say we didn't warn you. 🦖
      </p>

      <!-- Morphing text: cycles through what's inside -->
      <div class="h-12 mb-8 relative">
        <MorphingText
          texts={["Open WebUI Desktop", "Local AI Apps", "Cool Open Source", "Desktop Wrappers", "Electron Magic", "Things That Actually Work"]}
          class="text-2xl sm:text-3xl text-primary h-12"
        />
      </div>

      <!-- CTA button -->
      <a
        href="/resources"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
        style="box-shadow: 4px 4px 0px 0px var(--color-border);"
        onmouseover="this.style.boxShadow='6px 6px 0px 0px var(--color-border)'"
        onmouseout="this.style.boxShadow='4px 4px 0px 0px var(--color-border)'"
      >
        Take me to the danger zone
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Newsletter -->
  <NewsletterForm />
</BaseLayout>
