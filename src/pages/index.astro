---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoGrid from '../components/VideoGrid.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import MorphingText from '../components/MorphingText.astro';
import { getCollection } from 'astro:content';

const allVideos = await getCollection('videos');
const sortedVideos = allVideos
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map(v => v.data);
const latestVideos = sortedVideos.slice(0, 6);

const categories = [
  { name: 'Local AI', desc: 'Run AI models on your own hardware', count: allVideos.filter(v => v.data.category === 'Local AI').length },
  { name: 'AI Tools', desc: 'Best tools to supercharge your workflow', count: allVideos.filter(v => v.data.category === 'AI Tools').length },
  { name: 'AI Assistants', desc: 'Reviews and tutorials on AI agents', count: allVideos.filter(v => v.data.category === 'AI Assistants').length },
  { name: 'Hardware', desc: 'GPU guides for AI workloads', count: allVideos.filter(v => v.data.category === 'Hardware').length },
  { name: 'About', desc: 'Channel intro and background', count: allVideos.filter(v => v.data.category === 'About').length },
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://techrex.saitejamothukuri.com/#website",
  "name": "TechRex",
  "alternateName": ["TechRex by Saiteja Mothukuri", "The TechRex"],
  "url": "https://techrex.saitejamothukuri.com/",
  "description": "AI tools, local models, developer workflows and hardware guides by Saiteja Mothukuri.",
  "publisher": { "@id": "https://techrex.saitejamothukuri.com/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://techrex.saitejamothukuri.com/videos/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://techrex.saitejamothukuri.com/#person",
  "name": "Saiteja Mothukuri",
  "alternateName": "Sai Teja Mothukuri",
  "url": "https://saitejamothukuri.com",
  "jobTitle": "Content Creator & AI Developer",
  "description": "AI educator and developer behind TechRex. Covers local AI models, developer tools, and hardware for AI workloads.",
  "worksFor": {
    "@type": "Organization",
    "@id": "https://techrex.saitejamothukuri.com/#organization",
    "name": "TechRex"
  },
  "knowsAbout": ["Local AI", "AI Tools", "Developer Workflows", "Hardware for AI", "Open Source", "Machine Learning"],
  "sameAs": [
    "https://www.youtube.com/@The_TechRex",
    "https://linkedin.com/in/venkatasaitejam",
    "https://github.com/saiteja007-mv",
    "https://saitejamothukuri.com"
  ]
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://techrex.saitejamothukuri.com/#organization",
  "name": "TechRex",
  "url": "https://techrex.saitejamothukuri.com/",
  "logo": {
    "@type": "ImageObject",
    "url": "https://techrex.saitejamothukuri.com/favicon.svg",
    "width": 512,
    "height": 512
  },
  "description": "AI tools, local models, developer workflows and hardware guides.",
  "foundingDate": "2025-11",
  "founder": {
    "@type": "Person",
    "@id": "https://techrex.saitejamothukuri.com/#person",
    "name": "Saiteja Mothukuri"
  },
  "sameAs": [
    "https://www.youtube.com/@The_TechRex",
    "https://linkedin.com/in/venkatasaitejam",
    "https://github.com/saiteja007-mv"
  ]
};

const homepageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://techrex.saitejamothukuri.com/",
  "url": "https://techrex.saitejamothukuri.com/",
  "name": "TechRex — AI Tools, Local AI & Developer Workflows",
  "description": "AI tools, local models, developer workflows and hardware guides. Learn to build and launch with the latest AI technology.",
  "isPartOf": { "@id": "https://techrex.saitejamothukuri.com/#website" },
  "about": { "@type": "Thing", "name": "AI Tools and Local AI Models" },
  "author": { "@id": "https://techrex.saitejamothukuri.com/#person" },
  "hasPart": [
    {
      "@type": "WebPage",
      "name": "Videos",
      "url": "https://techrex.saitejamothukuri.com/videos/",
      "description": "AI tools, local models, and hardware tutorial videos"
    },
    {
      "@type": "WebPage",
      "name": "About",
      "url": "https://techrex.saitejamothukuri.com/about/",
      "description": "About TechRex and the REX Method"
    },
    {
      "@type": "WebPage",
      "name": "Resources",
      "url": "https://techrex.saitejamothukuri.com/resources/",
      "description": "Open-source projects and curated AI resources"
    },
    {
      "@type": "WebPage",
      "name": "Token Usage",
      "url": "https://techrex.saitejamothukuri.com/token-usage/",
      "description": "AI token usage dashboard"
    }
  ]
};
---
<BaseLayout
  title="TechRex"
  description="AI tools, local models, developer workflows and hardware guides. Learn to build and launch with the latest AI technology."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  </Fragment>
  <!-- Hero -->
  <Hero />

  <section class="py-16 bg-[var(--color-bg)] border-b-2 border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] shadow-hard-sm">
          Start Here
        </span>
        <h2 class="font-heading font-extrabold text-3xl sm:text-4xl text-[var(--color-text)] mt-4 mb-3">
          Pick the path that matches what you want to build
        </h2>
        <p class="text-[var(--color-muted)] leading-relaxed">
          Watch tutorials on the <a href="/videos/" class="font-semibold text-primary hover:text-primary-hover transition-colors">Videos</a> page, browse practical tools on <a href="/resources/" class="font-semibold text-primary hover:text-primary-hover transition-colors">Resources</a>, or learn how TechRex approaches AI workflows on the <a href="/about/" class="font-semibold text-primary hover:text-primary-hover transition-colors">About</a> page.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          {
            href: '/videos/',
            label: 'Watch the workflow',
            title: 'Tutorial videos',
            description: 'Hands-on walkthroughs for local AI, hardware, agents, and developer tools.'
          },
          {
            href: '/resources/',
            label: 'Browse the stack',
            title: 'Projects and resources',
            description: 'Open-source projects, desktop tools, and practical things worth testing.'
          },
          {
            href: '/about/',
            label: 'Understand the method',
            title: 'How TechRex works',
            description: 'Context on the channel, the REX Method, and what problems these guides solve.'
          }
        ].map((item) => (
          <a
            href={item.href}
            class="rounded-2xl border-2 border-[var(--color-border)] bg-[var(--color-card)] p-6 shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200"
          >
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary mb-3">{item.label}</p>
            <h3 class="font-heading font-bold text-xl text-[var(--color-text)] mb-2">{item.title}</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Resources Callout -->
  <section class="py-12 bg-[var(--color-surface)] border-b-2 border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">

      <!-- Left: text -->
      <div class="flex items-center gap-4">
        <span class="text-3xl select-none">🦖</span>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-muted)] mb-0.5">Check out the Resources page for</p>
          <div class="h-8 relative w-72 sm:w-96">
            <MorphingText
              texts={["Cool Projects", "Open Source Gems", "Desktop Apps", "Local AI Tools", "Electron Magic", "Things That Actually Work"]}
              class="text-xl sm:text-2xl font-extrabold text-primary h-8"
            />
          </div>
        </div>
      </div>

      <!-- Right: CTA -->
      <a
        href="/resources/"
        class="shrink-0 inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[var(--color-text)] text-[var(--color-bg)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
        style="box-shadow: 4px 4px 0px 0px var(--color-border);"
        onmouseover="this.style.boxShadow='6px 6px 0px 0px var(--color-border)'"
        onmouseout="this.style.boxShadow='4px 4px 0px 0px var(--color-border)'"
      >
        Take me there
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Latest Videos -->
  <section class="py-20 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-[var(--color-text)]">
            Recent Videos
          </h2>
        </div>
        <a
          href="/videos/"
          class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-hover transition-colors duration-150 cursor-pointer"
        >
          View all
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <VideoGrid videos={latestVideos} columns={3} />

      <!-- Mobile view all -->
      <div class="mt-8 text-center sm:hidden">
        <a href="/videos/" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg border border-[var(--color-border)] text-sm font-medium text-[var(--color-text)] hover:border-primary hover:text-primary transition-colors duration-150 cursor-pointer">
          View all videos
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20 bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="font-heading font-bold text-3xl sm:text-4xl text-[var(--color-text)]">
          Explore Categories
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <a
            href={`/videos/#${cat.name.toLowerCase().replace(/\s+/g, '-')}`}
            class="bg-[var(--color-card)] border border-[var(--color-border)] rounded-lg p-5
                   hover:border-primary/50 hover:shadow-sm transition-all duration-150 cursor-pointer"
          >
            <p class="font-bold text-2xl text-primary mb-1">{cat.count}</p>
            <h3 class="font-semibold text-sm text-[var(--color-text)] mb-1">{cat.name}</h3>
            <p class="text-xs text-[var(--color-muted)] leading-relaxed">{cat.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <NewsletterForm />
</BaseLayout>
