function formatTokens(n: number): string {
  if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
  return n.toString();
}

function formatCost(n: number): string {
  return '$' + n.toFixed(2);
}

const sortedByCost = [...models].sort((a, b) => b.cost - a.cost);
const topModels = sortedByCost.filter(m => m.cost > 0).slice(0, 5);
const maxCost = topModels[0]?.cost || 1;

// Filter the daily trend to the last 30 calendar days from the most recent entry.
// Active-only days are kept (gaps where no usage was logged just don't appear).
const TREND_DAYS = 30;
const lastEntryDate = dailyData.length > 0 ? new Date(dailyData[dailyData.length - 1].date) : new Date();
const cutoffDate = new Date(lastEntryDate);
cutoffDate.setUTCDate(cutoffDate.getUTCDate() - (TREND_DAYS - 1));
const cutoffStr = cutoffDate.toISOString().slice(0, 10);
const recentDaily = dailyData.filter(d => d.date >= cutoffStr);

const maxDailyTokens = Math.max(...recentDaily.map(d => d.tokens), 1);
const maxDailyCost = Math.max(...recentDaily.map(d => d.cost), 0.01);
const peakTokenDay = recentDaily.find(d => d.tokens === maxDailyTokens);
const peakCostDay = recentDaily.find(d => d.cost === maxDailyCost);
const recentTotalTokens = recentDaily.reduce((s, d) => s + d.tokens, 0);
const recentTotalCost = recentDaily.reduce((s, d) => s + d.cost, 0);
---
<BaseLayout
  title="Token Usage — TechRex"
  description="AI token consumption dashboard tracking usage across models."
>
  <!-- Hero -->
  <section class="py-20 bg-[var(--color-bg)] border-b-2 border-[var(--color-border)] relative overflow-hidden">
    <div class="absolute inset-0 pattern-dots opacity-[0.04] pointer-events-none"></div>
    <div class="absolute top-10 right-16 w-10 h-10 rounded-full bg-primary/20 border-2 border-primary hidden lg:block"></div>
    <div class="absolute bottom-10 left-12 w-8 h-8 bg-[var(--color-mint)] border-2 border-[var(--color-border)] rotate-12 hidden lg:block" style="box-shadow: 3px 3px 0px 0px var(--color-border)"></div>
    <div class="absolute top-20 left-20 w-6 h-6 bg-[var(--color-accent)] border-2 border-[var(--color-border)] rotate-45 hidden lg:block" style="box-shadow: 2px 2px 0px 0px var(--color-border)"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl text-[var(--color-text)] mb-8 tracking-tight">
        Token Usage
      </h1>
      <div class="text-3xl sm:text-4xl text-[var(--color-text)] leading-snug text-center" style="font-family: 'Caveat', cursive; font-weight: 600;">
        <p class="mb-4">
          Jensen Huang at GTC 2026
        </p>
        <p>
          Tokens are the new Commodity, the new Currency of the AI era
        </p>
      </div>
    </div>
  </section>

  <!-- Summary Cards -->
  <section class="py-16 bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        <!-- Total Tokens -->
        <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center" style="background: rgba(139,92,246,0.1); box-shadow: 2px 2px 0px 0px var(--color-border)">
              <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
            </div>
            <span class="text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide">Total Tokens</span>
          </div>
          <p class="font-heading font-extrabold text-3xl text-[var(--color-text)]">{formatTokens(stats.total_tokens)}</p>
        </div>

        <!-- Total Cost -->
        <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center" style="background: rgba(244,114,182,0.1); box-shadow: 2px 2px 0px 0px var(--color-border)">
              <svg class="w-5 h-5 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <span class="text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide">Total Cost</span>
          </div>
          <p class="font-heading font-extrabold text-3xl text-[var(--color-text)]">{formatCost(stats.total_cost)}</p>
        </div>

        <!-- Models -->
        <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center" style="background: rgba(251,191,36,0.1); box-shadow: 2px 2px 0px 0px var(--color-border)">
              <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <span class="text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide">Models</span>
          </div>
          <p class="font-heading font-extrabold text-3xl text-[var(--color-text)]">{stats.model_count}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Models by Cost -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold shadow-hard-sm text-primary">
          Top 5
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)]">Models by Cost</h2>
      </div>

      <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard space-y-4">
        {topModels.map((m) => {
          const pct = Math.max((m.cost / maxCost) * 100, 2);
          return (
            <div class="flex items-center gap-4">
              <span class="text-xs font-mono font-semibold text-[var(--color-text)] w-44 sm:w-52 truncate shrink-0" title={m.model}>{m.model}</span>
              <div class="flex-1 h-8 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] overflow-hidden relative">
                <div
                  class="h-full bg-primary rounded-lg"
                  style={`width: ${pct}%`}
                ></div>
              </div>
              <span class="text-sm font-bold text-[var(--color-text)] w-20 text-right shrink-0">{formatCost(m.cost)}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Daily Trend -->
  <section class="py-16 bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3 flex-wrap">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold shadow-hard-sm text-[var(--color-accent)]">
          Last {TREND_DAYS} days
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)]">Daily Trend</h2>
      </div>
      <p class="text-sm text-[var(--color-muted)] mb-8 max-w-2xl">
        {recentDaily.length} active days · {formatTokens(recentTotalTokens)} tokens · {formatCost(recentTotalCost)} spent · range {recentDaily[0]?.date} → {recentDaily[recentDaily.length - 1]?.date}
      </p>

      <!-- Daily tokens -->
      <div data-trend-chart="tokens" class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 sm:p-7 shadow-hard mb-6 relative">
        <div class="flex items-baseline justify-between mb-5 flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-sm bg-primary border border-[var(--color-border)]"></span>
            <h3 class="font-heading font-bold text-base text-[var(--color-text)]">Tokens per day</h3>
          </div>
          <span class="text-xs text-[var(--color-muted)] font-mono">
            peak <span class="text-[var(--color-text)] font-bold">{formatTokens(maxDailyTokens)}</span> on {peakTokenDay?.date}
          </span>
        </div>
        <div data-trend-bars class="flex items-end gap-1 h-40 overflow-x-auto pb-1 relative">
          {recentDaily.map((d) => {
            const h = Math.max((d.tokens / maxDailyTokens) * 100, 2);
            return (
              <div
                data-tt-date={d.date}
                data-tt-tokens={d.tokens}
                data-tt-cost={d.cost}
                class="flex-1 min-w-[10px] bg-primary rounded-sm hover:opacity-70 transition-opacity cursor-help border-r border-[var(--color-card)]"
                style={`height: ${h}%`}
              ></div>
            );
          })}
        </div>
        <div class="flex justify-between mt-3 text-[10px] font-mono text-[var(--color-muted)]">
          <span>{recentDaily[0]?.date}</span>
          <span class="hidden sm:inline">{recentDaily[Math.floor(recentDaily.length / 2)]?.date}</span>
          <span>{recentDaily[recentDaily.length - 1]?.date}</span>
        </div>
        <!-- Tooltip -->
        <div data-trend-tooltip class="hidden absolute z-20 pointer-events-none px-3 py-2 rounded-lg bg-[var(--color-text)] text-[var(--color-bg)] text-xs font-mono shadow-hard-sm border-2 border-[var(--color-border)] whitespace-nowrap">
          <div data-tt-out-date class="font-bold mb-0.5">—</div>
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-primary"></span><span data-tt-out-tokens>—</span> tokens</div>
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-secondary"></span><span data-tt-out-cost>—</span></div>
        </div>
      </div>

      <!-- Daily cost -->
      <div data-trend-chart="cost" class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 sm:p-7 shadow-hard relative">
        <div class="flex items-baseline justify-between mb-5 flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-sm bg-secondary border border-[var(--color-border)]"></span>
            <h3 class="font-heading font-bold text-base text-[var(--color-text)]">Cost per day</h3>
          </div>
          <span class="text-xs text-[var(--color-muted)] font-mono">
            peak <span class="text-[var(--color-text)] font-bold">{formatCost(maxDailyCost)}</span> on {peakCostDay?.date}
          </span>
        </div>
        <div data-trend-bars class="flex items-end gap-1 h-40 overflow-x-auto pb-1 relative">
          {recentDaily.map((d) => {
            const h = Math.max((d.cost / maxDailyCost) * 100, 2);
            return (
              <div
                data-tt-date={d.date}
                data-tt-tokens={d.tokens}
                data-tt-cost={d.cost}
                class="flex-1 min-w-[10px] bg-secondary rounded-sm hover:opacity-70 transition-opacity cursor-help border-r border-[var(--color-card)]"
                style={`height: ${h}%`}
              ></div>
            );
          })}
        </div>
        <div class="flex justify-between mt-3 text-[10px] font-mono text-[var(--color-muted)]">
          <span>{recentDaily[0]?.date}</span>
          <span class="hidden sm:inline">{recentDaily[Math.floor(recentDaily.length / 2)]?.date}</span>
          <span>{recentDaily[recentDaily.length - 1]?.date}</span>
        </div>
        <!-- Tooltip -->
        <div data-trend-tooltip class="hidden absolute z-20 pointer-events-none px-3 py-2 rounded-lg bg-[var(--color-text)] text-[var(--color-bg)] text-xs font-mono shadow-hard-sm border-2 border-[var(--color-border)] whitespace-nowrap">
          <div data-tt-out-date class="font-bold mb-0.5">—</div>
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-primary"></span><span data-tt-out-tokens>—</span> tokens</div>
          <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-sm bg-secondary"></span><span data-tt-out-cost>—</span></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initTrendTooltips() {
      function fmtTokens(n: number): string {
        if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(2) + 'B';
        if (n >= 1_000_000) return (n / 1_000_000).toFixed(2) + 'M';
        if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
        return n.toLocaleString();
      }
      function fmtCost(n: number): string { return '$' + n.toFixed(2); }

      document.querySelectorAll<HTMLElement>('[data-trend-chart]').forEach((chart) => {
        if (chart.dataset.wired === '1') return;
        chart.dataset.wired = '1';

        const tt = chart.querySelector<HTMLElement>('[data-trend-tooltip]');
        const ttDate = tt?.querySelector<HTMLElement>('[data-tt-out-date]');
        const ttTokens = tt?.querySelector<HTMLElement>('[data-tt-out-tokens]');
        const ttCost = tt?.querySelector<HTMLElement>('[data-tt-out-cost]');
        const bars = chart.querySelector<HTMLElement>('[data-trend-bars]');
        if (!tt || !ttDate || !ttTokens || !ttCost || !bars) return;

        bars.querySelectorAll<HTMLElement>('[data-tt-date]').forEach((bar) => {
          bar.addEventListener('mouseenter', () => {
            ttDate.textContent = bar.dataset.ttDate || '';
            ttTokens.textContent = fmtTokens(Number(bar.dataset.ttTokens || 0));
            ttCost.textContent = fmtCost(Number(bar.dataset.ttCost || 0));
            tt.classList.remove('hidden');
          });
          bar.addEventListener('mousemove', (e) => {
            const rect = chart.getBoundingClientRect();
            const x = (e as MouseEvent).clientX - rect.left;
            const y = (e as MouseEvent).clientY - rect.top;
            // Position tooltip above-and-right of cursor; flip horizontally near right edge.
            const ttRect = tt.getBoundingClientRect();
            const left = x + 14 + ttRect.width > rect.width ? x - ttRect.width - 14 : x + 14;
            const top = Math.max(8, y - ttRect.height - 10);
            tt.style.left = left + 'px';
            tt.style.top = top + 'px';
          });
          bar.addEventListener('mouseleave', () => {
            tt.classList.add('hidden');
          });
        });
      });
    }

    initTrendTooltips();
    document.addEventListener('astro:page-load', initTrendTooltips);
  </script>

</BaseLayout>
