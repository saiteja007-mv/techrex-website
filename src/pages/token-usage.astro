---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = {
  total_tokens: 734_766_646,
  total_cost: 280.18,
  model_count: 36,
  total_records: 158,
  updated_at: '2026-03-21',
};

const models = [
  { model: 'claude-sonnet-4-6', tokens: 429766075, cost: 194.97, records: 23 },
  { model: 'claude-sonnet-4-5', tokens: 33758610, cost: 20.01, records: 16 },
  { model: 'k2p5', tokens: 99000047, cost: 18.60, records: 4 },
  { model: 'gpt-5.4', tokens: 19998932, cost: 13.64, records: 1 },
  { model: 'gpt-5-codex', tokens: 52180755, cost: 11.89, records: 4 },
  { model: 'gpt-5', tokens: 10013034, cost: 5.49, records: 6 },
  { model: 'gpt-5.1-codex-max', tokens: 10809849, cost: 4.77, records: 8 },
  { model: 'claude-haiku-4-5', tokens: 14179588, cost: 3.51, records: 15 },
  { model: 'gpt-5.1-codex', tokens: 3630735, cost: 1.91, records: 1 },
  { model: 'gpt-5.2-codex', tokens: 2664969, cost: 1.81, records: 3 },
  { model: 'gpt-5.3-codex', tokens: 3282570, cost: 1.66, records: 2 },
  { model: 'kimi-for-coding', tokens: 3849259, cost: 0.99, records: 5 },
  { model: 'claude-opus-4-5', tokens: 145591, cost: 0.77, records: 2 },
  { model: 'unsloth/qwen3.5-35b-a3b', tokens: 738960, cost: 0.09, records: 2 },
  { model: 'qwen/qwen3.5-35b-a3b', tokens: 432213, cost: 0.06, records: 3 },
  { model: 'kimi-coding/k2-thinking', tokens: 22350, cost: 0.01, records: 3 },
  { model: 'qwen/qwen3.5-9b', tokens: 94896, cost: 0.005, records: 1 },
  { model: '<synthetic>', tokens: 0, cost: 0, records: 20 },
  { model: 'claude sonnet 4-5', tokens: 716068, cost: 0, records: 1 },
  { model: 'claude-opus-4-6', tokens: 40585989, cost: 0, records: 11 },
  { model: 'gemini-2.5-flash', tokens: 14450, cost: 0, records: 1 },
  { model: 'gemini-2.5-pro', tokens: 376414, cost: 0, records: 2 },
  { model: 'gemini-3-flash-preview', tokens: 1627500, cost: 0, records: 4 },
  { model: 'gemini-3-pro-preview', tokens: 3010170, cost: 0, records: 3 },
  { model: 'gpt-5.1', tokens: 1701179, cost: 0, records: 3 },
  { model: 'gpt-5.2-chat-latest', tokens: 0, cost: 0, records: 1 },
  { model: 'heartbeat', tokens: 0, cost: 0, records: 2 },
  { model: 'huihui_ai/orchestrator-abliterated:8b', tokens: 0, cost: 0, records: 1 },
  { model: 'lfm2-1.2b-tool', tokens: 73848, cost: 0, records: 1 },
  { model: 'liquid/lfm2-24b-a2b', tokens: 71676, cost: 0, records: 2 },
  { model: 'nvidia/nemotron-3-nano-4b', tokens: 1913448, cost: 0, records: 1 },
  { model: 'openai/gpt-oss-20b', tokens: 0, cost: 0, records: 1 },
  { model: 'openrouter/pony-alpha', tokens: 99191, cost: 0, records: 1 },
  { model: 'qwen/qwen3-30b-a3b-2507', tokens: 0, cost: 0, records: 1 },
  { model: 'qwen3.5:27b', tokens: 8280, cost: 0, records: 2 },
  { model: 'qwen3.5:35b-a3b', tokens: 0, cost: 0, records: 1 },
];

function formatTokens(n: number): string {
  if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
  return n.toString();
}

function formatCost(n: number): string {
  return '$' + n.toFixed(2);
}

const sortedByCost = [...models].sort((a, b) => b.cost - a.cost);
const topModels = sortedByCost.filter(m => m.cost > 0).slice(0, 10);
const maxCost = topModels[0]?.cost || 1;

const totalTableTokens = models.reduce((s, m) => s + m.tokens, 0);
const totalTableCost = models.reduce((s, m) => s + m.cost, 0);
const totalTableRecords = models.reduce((s, m) => s + m.records, 0);
---
<BaseLayout
  title="Token Usage — TechRex"
  description="AI token consumption dashboard tracking usage across models."
>
  <!-- Hero -->
  <section class="py-20 bg-[var(--color-bg)] border-b-2 border-[var(--color-border)] relative overflow-hidden">
    <div class="absolute inset-0 pattern-dots opacity-[0.04] pointer-events-none"></div>
    <div class="absolute top-10 right-16 w-10 h-10 rounded-full bg-primary/20 border-2 border-primary hidden lg:block"></div>
    <div class="absolute bottom-10 left-12 w-8 h-8 bg-[var(--color-mint)] border-2 border-[var(--color-border)] rotate-12 hidden lg:block" style="box-shadow: 3px 3px 0px 0px var(--color-border)"></div>
    <div class="absolute top-20 left-20 w-6 h-6 bg-[var(--color-accent)] border-2 border-[var(--color-border)] rotate-45 hidden lg:block" style="box-shadow: 2px 2px 0px 0px var(--color-border)"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-6 shadow-hard-sm">
        Dashboard
      </span>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl text-[var(--color-text)] mb-4 tracking-tight">
        Token Usage
      </h1>
      <p class="text-[var(--color-muted)] text-lg max-w-2xl leading-relaxed mb-4">
        AI token consumption across all models — {stats.total_records} records tracked.
      </p>
      <span class="text-xs text-[var(--color-muted)]">Last updated: {stats.updated_at}</span>
    </div>
  </section>

  <!-- Summary Cards -->
  <section class="py-16 bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        <!-- Total Tokens -->
        <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center" style="background: rgba(139,92,246,0.1); box-shadow: 2px 2px 0px 0px var(--color-border)">
              <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
            </div>
            <span class="text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide">Total Tokens</span>
          </div>
          <p class="font-heading font-extrabold text-3xl text-[var(--color-text)]">{formatTokens(stats.total_tokens)}</p>
        </div>

        <!-- Total Cost -->
        <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center" style="background: rgba(244,114,182,0.1); box-shadow: 2px 2px 0px 0px var(--color-border)">
              <svg class="w-5 h-5 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <span class="text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide">Total Cost</span>
          </div>
          <p class="font-heading font-extrabold text-3xl text-[var(--color-text)]">{formatCost(stats.total_cost)}</p>
        </div>

        <!-- Models -->
        <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center" style="background: rgba(251,191,36,0.1); box-shadow: 2px 2px 0px 0px var(--color-border)">
              <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <span class="text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide">Models</span>
          </div>
          <p class="font-heading font-extrabold text-3xl text-[var(--color-text)]">{stats.model_count}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Models by Cost -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold shadow-hard-sm text-primary">
          Top 10
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)]">Models by Cost</h2>
      </div>

      <div class="bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-2xl p-6 shadow-hard space-y-4">
        {topModels.map((m) => {
          const pct = Math.max((m.cost / maxCost) * 100, 2);
          return (
            <div class="flex items-center gap-4">
              <span class="text-xs font-mono font-semibold text-[var(--color-text)] w-44 sm:w-52 truncate shrink-0" title={m.model}>{m.model}</span>
              <div class="flex-1 h-8 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] overflow-hidden relative">
                <div
                  class="h-full bg-primary rounded-lg"
                  style={`width: ${pct}%`}
                ></div>
              </div>
              <span class="text-sm font-bold text-[var(--color-text)] w-20 text-right shrink-0">{formatCost(m.cost)}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Model Table -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold shadow-hard-sm text-[var(--color-accent)]">
          All {stats.model_count}
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)]">Model Breakdown</h2>
      </div>

      <div class="overflow-x-auto rounded-2xl border-2 border-[var(--color-border)] shadow-hard">
        <table class="w-full text-left">
          <thead>
            <tr>
              <th class="px-6 py-4 text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide bg-[var(--color-surface)] border-b-2 border-[var(--color-border)]">Model</th>
              <th data-sort="tokens" class="px-6 py-4 text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide bg-[var(--color-surface)] border-b-2 border-[var(--color-border)] cursor-pointer hover:text-primary transition-colors">
                Tokens <span class="sort-arrow"></span>
              </th>
              <th data-sort="cost" class="px-6 py-4 text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide bg-[var(--color-surface)] border-b-2 border-[var(--color-border)] cursor-pointer hover:text-primary transition-colors">
                Cost <span class="sort-arrow">&darr;</span>
              </th>
              <th data-sort="records" class="px-6 py-4 text-xs font-bold text-[var(--color-muted)] uppercase tracking-wide bg-[var(--color-surface)] border-b-2 border-[var(--color-border)] cursor-pointer hover:text-primary transition-colors">
                Records <span class="sort-arrow"></span>
              </th>
            </tr>
          </thead>
          <tbody id="model-table-body">
            {sortedByCost.map((m) => (
              <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface)] transition-colors">
                <td class="px-6 py-4 text-sm font-mono font-semibold text-[var(--color-text)]">{m.model}</td>
                <td class="px-6 py-4 text-sm text-[var(--color-text)]">{formatTokens(m.tokens)}</td>
                <td class="px-6 py-4 text-sm font-semibold text-[var(--color-text)]">{formatCost(m.cost)}</td>
                <td class="px-6 py-4 text-sm text-[var(--color-muted)]">{m.records}</td>
              </tr>
            ))}
            <tr class="bg-[var(--color-surface)] border-t-2 border-[var(--color-border)]">
              <td class="px-6 py-4 text-sm font-bold text-[var(--color-text)]">Total ({models.length} models)</td>
              <td class="px-6 py-4 text-sm font-bold text-[var(--color-text)]">{formatTokens(totalTableTokens)}</td>
              <td class="px-6 py-4 text-sm font-bold text-primary">{formatCost(totalTableCost)}</td>
              <td class="px-6 py-4 text-sm font-bold text-[var(--color-muted)]">{totalTableRecords}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initSortableTable() {
    const models = [
      { model: 'claude-sonnet-4-6', tokens: 429766075, cost: 194.97, records: 23 },
      { model: 'claude-sonnet-4-5', tokens: 33758610, cost: 20.01, records: 16 },
      { model: 'k2p5', tokens: 99000047, cost: 18.60, records: 4 },
      { model: 'gpt-5.4', tokens: 19998932, cost: 13.64, records: 1 },
      { model: 'gpt-5-codex', tokens: 52180755, cost: 11.89, records: 4 },
      { model: 'gpt-5', tokens: 10013034, cost: 5.49, records: 6 },
      { model: 'gpt-5.1-codex-max', tokens: 10809849, cost: 4.77, records: 8 },
      { model: 'claude-haiku-4-5', tokens: 14179588, cost: 3.51, records: 15 },
      { model: 'gpt-5.1-codex', tokens: 3630735, cost: 1.91, records: 1 },
      { model: 'gpt-5.2-codex', tokens: 2664969, cost: 1.81, records: 3 },
      { model: 'gpt-5.3-codex', tokens: 3282570, cost: 1.66, records: 2 },
      { model: 'kimi-for-coding', tokens: 3849259, cost: 0.99, records: 5 },
      { model: 'claude-opus-4-5', tokens: 145591, cost: 0.77, records: 2 },
      { model: 'unsloth/qwen3.5-35b-a3b', tokens: 738960, cost: 0.09, records: 2 },
      { model: 'qwen/qwen3.5-35b-a3b', tokens: 432213, cost: 0.06, records: 3 },
      { model: 'kimi-coding/k2-thinking', tokens: 22350, cost: 0.01, records: 3 },
      { model: 'qwen/qwen3.5-9b', tokens: 94896, cost: 0.005, records: 1 },
      { model: '<synthetic>', tokens: 0, cost: 0, records: 20 },
      { model: 'claude sonnet 4-5', tokens: 716068, cost: 0, records: 1 },
      { model: 'claude-opus-4-6', tokens: 40585989, cost: 0, records: 11 },
      { model: 'gemini-2.5-flash', tokens: 14450, cost: 0, records: 1 },
      { model: 'gemini-2.5-pro', tokens: 376414, cost: 0, records: 2 },
      { model: 'gemini-3-flash-preview', tokens: 1627500, cost: 0, records: 4 },
      { model: 'gemini-3-pro-preview', tokens: 3010170, cost: 0, records: 3 },
      { model: 'gpt-5.1', tokens: 1701179, cost: 0, records: 3 },
      { model: 'gpt-5.2-chat-latest', tokens: 0, cost: 0, records: 1 },
      { model: 'heartbeat', tokens: 0, cost: 0, records: 2 },
      { model: 'huihui_ai/orchestrator-abliterated:8b', tokens: 0, cost: 0, records: 1 },
      { model: 'lfm2-1.2b-tool', tokens: 73848, cost: 0, records: 1 },
      { model: 'liquid/lfm2-24b-a2b', tokens: 71676, cost: 0, records: 2 },
      { model: 'nvidia/nemotron-3-nano-4b', tokens: 1913448, cost: 0, records: 1 },
      { model: 'openai/gpt-oss-20b', tokens: 0, cost: 0, records: 1 },
      { model: 'openrouter/pony-alpha', tokens: 99191, cost: 0, records: 1 },
      { model: 'qwen/qwen3-30b-a3b-2507', tokens: 0, cost: 0, records: 1 },
      { model: 'qwen3.5:27b', tokens: 8280, cost: 0, records: 2 },
      { model: 'qwen3.5:35b-a3b', tokens: 0, cost: 0, records: 1 },
    ];

    let currentSort = { col: 'cost', dir: 'desc' };

    function formatTokens(n: number): string {
      if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';
      if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
      if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
      return n.toString();
    }

    function formatCost(n: number): string {
      return '$' + n.toFixed(2);
    }

    function renderTable() {
      const sorted = [...models].sort((a: any, b: any) => {
        const dir = currentSort.dir === 'asc' ? 1 : -1;
        return (a[currentSort.col] - b[currentSort.col]) * dir;
      });

      const totalTokens = models.reduce((s, m) => s + m.tokens, 0);
      const totalCost = models.reduce((s, m) => s + m.cost, 0);
      const totalRecords = models.reduce((s, m) => s + m.records, 0);

      const tbody = document.getElementById('model-table-body');
      if (!tbody) return;

      tbody.innerHTML = sorted.map(m => `
        <tr class="border-b border-[var(--color-border)] hover:bg-[var(--color-surface)] transition-colors">
          <td class="px-6 py-4 text-sm font-mono font-semibold text-[var(--color-text)]">${m.model}</td>
          <td class="px-6 py-4 text-sm text-[var(--color-text)]">${formatTokens(m.tokens)}</td>
          <td class="px-6 py-4 text-sm font-semibold text-[var(--color-text)]">${formatCost(m.cost)}</td>
          <td class="px-6 py-4 text-sm text-[var(--color-muted)]">${m.records}</td>
        </tr>`).join('') + `
        <tr class="bg-[var(--color-surface)] border-t-2 border-[var(--color-border)]">
          <td class="px-6 py-4 text-sm font-bold text-[var(--color-text)]">Total (${sorted.length} models)</td>
          <td class="px-6 py-4 text-sm font-bold text-[var(--color-text)]">${formatTokens(totalTokens)}</td>
          <td class="px-6 py-4 text-sm font-bold text-primary">${formatCost(totalCost)}</td>
          <td class="px-6 py-4 text-sm font-bold text-[var(--color-muted)]">${totalRecords}</td>
        </tr>`;

      document.querySelectorAll('[data-sort]').forEach(th => {
        const arrow = th.querySelector('.sort-arrow') as HTMLElement;
        if (!arrow) return;
        const col = (th as HTMLElement).dataset.sort;
        arrow.textContent = col === currentSort.col ? (currentSort.dir === 'asc' ? ' \u2191' : ' \u2193') : '';
      });
    }

    document.querySelectorAll('[data-sort]').forEach(th => {
      th.addEventListener('click', () => {
        const col = (th as HTMLElement).dataset.sort!;
        if (currentSort.col === col) {
          currentSort.dir = currentSort.dir === 'asc' ? 'desc' : 'asc';
        } else {
          currentSort = { col, dir: 'desc' };
        }
        renderTable();
      });
    });
  }

  initSortableTable();
  document.addEventListener('astro:page-load', initSortableTable);
</script>
