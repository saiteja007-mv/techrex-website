function formatTokens(n: number): string {
  if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
  return n.toString();
}

function formatCost(n: number): string {
  return '$' + n.toFixed(2);
}

const sortedByCost = [...models].sort((a, b) => b.cost - a.cost);
const topModels = sortedByCost.filter(m => m.cost > 0).slice(0, 5);
const maxCost = topModels[0]?.cost || 1;

// Filter the daily trend to the last 30 calendar days from the most recent entry.
// Active-only days are kept (gaps where no usage was logged just don't appear).
const TREND_DAYS = 30;
const lastEntryDate = dailyData.length > 0 ? new Date(dailyData[dailyData.length - 1].date) : new Date();
const cutoffDate = new Date(lastEntryDate);
cutoffDate.setUTCDate(cutoffDate.getUTCDate() - (TREND_DAYS - 1));
const cutoffStr = cutoffDate.toISOString().slice(0, 10);
const recentDaily = dailyData.filter(d => d.date >= cutoffStr);

const maxDailyTokens = Math.max(...recentDaily.map(d => d.tokens), 1);
const maxDailyCost = Math.max(...recentDaily.map(d => d.cost), 0.01);
const peakTokenDay = recentDaily.find(d => d.tokens === maxDailyTokens);
const peakCostDay = recentDaily.find(d => d.cost === maxDailyCost);
const recentTotalTokens = recentDaily.reduce((s, d) => s + d.tokens, 0);
const recentTotalCost = recentDaily.reduce((s, d) => s + d.cost, 0);
