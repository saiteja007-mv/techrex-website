---
import BaseLayout from '../layouts/BaseLayout.astro';
import RexMethod from '../components/RexMethod.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/channel-avatar.jpg';
import channelInfo from '../data/channel-info.json';

const { branding, socialLinks, channel } = channelInfo;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Saiteja Mothukuri",
  "url": "https://saitejamothukuri.com",
  "sameAs": [
    "https://www.youtube.com/@The_TechRex",
    "https://linkedin.com/in/venkatasaitejam",
    "https://github.com/saiteja007-mv"
  ]
};
---
<BaseLayout
  title="About — TechRex"
  description="Learn about TechRex, the REX Method, and the mission to help developers build and launch with AI tools without the struggle."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <!-- Hero header -->
  <section class="py-20 bg-bg dark:bg-bg-dark border-b border-border dark:border-border-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
        <!-- Avatar -->
        <div class="relative flex-shrink-0">
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-primary to-secondary opacity-20 blur-xl scale-110"></div>
          <Image
            src={avatar}
            alt="TechRex channel avatar"
            width={120}
            height={120}
            class="relative z-10 w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-bg dark:border-bg-dark ring-2 ring-primary/30"
          />
        </div>

        <!-- Bio -->
        <div class="text-center sm:text-left">
          <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium mb-4">About the Channel</span>
          <h1 class="font-heading font-bold text-4xl sm:text-5xl text-text dark:text-text-dark mb-3">
            <span class="text-primary">Tech</span><span class="text-accent">Rex</span>
          </h1>
          <p class="text-muted dark:text-muted-dark text-base sm:text-lg mb-2 leading-relaxed max-w-xl">
            {branding.tagline}
          </p>
          <p class="font-mono text-sm text-muted dark:text-muted-dark italic">"{branding.catchphrase}"</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-16 bg-surface dark:bg-surface-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-medium mb-4">Our Mission</span>
          <h2 class="font-heading font-bold text-2xl sm:text-3xl text-text dark:text-text-dark mb-4">
            Evolve or Get Extinct
          </h2>
          <p class="text-muted dark:text-muted-dark text-sm leading-relaxed mb-4">
            TechRex exists to close the gap between AI hype and practical use. We test the tools, build the projects, and show the implementations — so you skip the frustration and get straight to results.
          </p>
          <p class="text-muted dark:text-muted-dark text-sm leading-relaxed">
            Every video follows The REX Method: start with the right <strong class="text-text dark:text-text-dark">Resources</strong>, build through <strong class="text-text dark:text-text-dark">Experiments</strong>, and ship with real <strong class="text-text dark:text-text-dark">eXecution</strong>.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { label: 'Total Views', value: parseInt(channel.statistics.viewCount).toLocaleString() + '+', color: 'text-primary' },
            { label: 'Subscribers', value: channel.statistics.subscriberCount + '+', color: 'text-secondary' },
            { label: 'Videos Published', value: channel.statistics.videoCount + '+', color: 'text-accent' },
            { label: 'Channel Since', value: 'Nov 2025', color: 'text-purple-500' },
          ].map(stat => (
            <div class="p-5 rounded-xl bg-card dark:bg-card-dark border border-border dark:border-border-dark text-center">
              <p class={`font-heading font-bold text-2xl mb-1 ${stat.color}`}>{stat.value}</p>
              <p class="text-xs text-muted dark:text-muted-dark uppercase tracking-wide">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REX Method -->
  <RexMethod />

  <!-- Connect -->
  <section class="py-16 bg-surface dark:bg-surface-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-medium mb-4">Get in Touch</span>
      <h2 class="font-heading font-bold text-2xl sm:text-3xl text-text dark:text-text-dark mb-3">Connect with TechRex</h2>
      <p class="text-muted dark:text-muted-dark text-sm mb-8 max-w-md mx-auto">Follow along on your platform of choice, or reach out directly.</p>
      <div class="flex justify-center mb-6">
        <SocialLinks variant="row" />
      </div>
      <a
        href={`mailto:${socialLinks.email}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border dark:border-border-dark text-sm text-muted dark:text-muted-dark hover:border-primary hover:text-primary transition-all duration-200 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {socialLinks.email}
      </a>
    </div>
  </section>
</BaseLayout>
