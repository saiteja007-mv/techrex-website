---
import BaseLayout from '../layouts/BaseLayout.astro';
import RexMethod from '../components/RexMethod.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/channel-avatar.jpg';
import channelInfo from '../data/channel-info.json';

const { branding, socialLinks, channel } = channelInfo;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://techrex.saitejamothukuri.com/" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://techrex.saitejamothukuri.com/about/" }
  ]
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://techrex.saitejamothukuri.com/#person",
  "name": "Saiteja Mothukuri",
  "alternateName": "Sai Teja Mothukuri",
  "url": "https://saitejamothukuri.com",
  "jobTitle": "Content Creator & AI Developer",
  "description": "AI educator and developer behind TechRex. Covers local AI models, developer tools, and hardware for AI workloads.",
  "worksFor": {
    "@type": "Organization",
    "@id": "https://techrex.saitejamothukuri.com/#organization",
    "name": "TechRex"
  },
  "knowsAbout": ["Local AI", "AI Tools", "Developer Workflows", "Hardware for AI", "Open Source", "Machine Learning"],
  "sameAs": [
    "https://www.youtube.com/@The_TechRex",
    "https://linkedin.com/in/venkatasaitejam",
    "https://github.com/saiteja007-mv",
    "https://saitejamothukuri.com"
  ]
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": "https://techrex.saitejamothukuri.com/about/",
  "url": "https://techrex.saitejamothukuri.com/about/",
  "name": "About — TechRex",
  "description": "Learn about TechRex, the REX Method, and the mission to help developers build and launch with AI tools without the struggle.",
  "isPartOf": { "@id": "https://techrex.saitejamothukuri.com/#website" },
  "about": { "@id": "https://techrex.saitejamothukuri.com/#person" },
  "mainEntity": { "@id": "https://techrex.saitejamothukuri.com/#person" }
};
---
<BaseLayout
  title="About — TechRex"
  description="Learn about TechRex, the REX Method, and the mission to help developers build and launch with AI tools without the struggle."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  </Fragment>

  <!-- Hero header -->
  <section class="py-20 bg-[var(--color-bg)] border-b border-[var(--color-border)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
        <!-- Avatar -->
        <div class="relative flex-shrink-0">
          <Image
            src={avatar}
            alt="TechRex channel avatar"
            width={120}
            height={120}
            class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover ring-2 ring-[var(--color-border)]"
          />
        </div>

        <!-- Bio -->
        <div class="text-center sm:text-left">
          <span class="inline-block px-3 py-1 rounded-md bg-primary/10 text-primary text-xs font-medium mb-4">About the Channel</span>
          <h1 class="font-heading font-bold text-4xl sm:text-5xl text-[var(--color-text)] mb-3">
            <span class="text-primary">Tech</span><span class="text-accent">Rex</span>
          </h1>
          <p class="text-[var(--color-muted)] text-base sm:text-lg mb-2 leading-relaxed max-w-xl">
            {branding.tagline}
          </p>
          <p class="font-mono text-sm text-[var(--color-muted)] italic">"{branding.catchphrase}"</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-16 bg-[var(--color-surface)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
        <div>
          <span class="inline-block px-3 py-1 rounded-md bg-secondary/10 text-secondary text-xs font-medium mb-4">Our Mission</span>
          <h2 class="font-heading font-bold text-2xl sm:text-3xl text-[var(--color-text)] mb-4">
            Evolve or Get Extinct
          </h2>
          <p class="text-[var(--color-muted)] text-sm leading-relaxed mb-4">
            TechRex exists to close the gap between AI hype and practical use. We test the tools, build the projects, and show the implementations — so you skip the frustration and get straight to results.
          </p>
          <p class="text-[var(--color-muted)] text-sm leading-relaxed">
            Every video follows The REX Method: start with the right <strong class="text-[var(--color-text)]">Resources</strong>, build through <strong class="text-[var(--color-text)]">Experiments</strong>, and ship with real <strong class="text-[var(--color-text)]">eXecution</strong>.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { label: 'Total Views', value: parseInt(channel.statistics.viewCount).toLocaleString() + '+', color: 'text-primary' },
            { label: 'Subscribers', value: channel.statistics.subscriberCount + '+', color: 'text-secondary' },
            { label: 'Videos Published', value: channel.statistics.videoCount + '+', color: 'text-accent' },
            { label: 'Channel Since', value: 'Nov 2025', color: 'text-purple-500' },
          ].map(stat => (
            <div class="p-5 rounded-lg bg-[var(--color-card)] border border-[var(--color-border)] text-center">
              <p class={`font-heading font-bold text-2xl mb-1 ${stat.color}`}>{stat.value}</p>
              <p class="text-xs text-[var(--color-muted)] uppercase tracking-wide">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- REX Method -->
  <RexMethod />

  <!-- Connect -->
  <section class="py-16 bg-[var(--color-surface)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-md bg-accent/10 text-accent text-xs font-medium mb-4">Get in Touch</span>
      <h2 class="font-heading font-bold text-2xl sm:text-3xl text-[var(--color-text)] mb-3">Connect with TechRex</h2>
      <p class="text-[var(--color-muted)] text-sm mb-8 max-w-md mx-auto">Follow along on your platform of choice, or reach out directly.</p>
      <div class="flex justify-center mb-6">
        <SocialLinks variant="row" />
      </div>
      <a
        href={`mailto:${socialLinks.email}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-[var(--color-border)] text-sm text-[var(--color-muted)] hover:border-primary hover:text-primary transition-all duration-150 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {socialLinks.email}
      </a>
    </div>
  </section>

  <section class="py-16 bg-[var(--color-bg)] border-t border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border-2 border-[var(--color-border)] bg-[var(--color-card)] p-8 shadow-hard">
        <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-4">
          Where to go next
        </span>
        <h2 class="font-heading font-bold text-2xl text-[var(--color-text)] mb-3">Keep exploring the practical side of the channel</h2>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-6 max-w-2xl">
          If you want the hands-on implementation, watch the <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:text-primary-hover transition-colors">YouTube channel</a>. If you want the tools, open-source projects, and builds referenced across the channel, start with <a href="/resources/" class="font-semibold text-primary hover:text-primary-hover transition-colors">Resources</a>.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-white text-sm font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
            Watch on YouTube
          </a>
          <a href="/resources/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-bg)] text-[var(--color-text)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200">
            Explore resources
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
