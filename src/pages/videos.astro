---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getCollection } from 'astro:content';

const allVideos = await getCollection('videos');
const sortedVideos = allVideos
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map(v => v.data);

const categories = ['Local AI', 'AI Tools', 'AI Assistants', 'Hardware', 'About'];
const counts: Record<string, number> = {};
categories.forEach(cat => {
  counts[cat] = allVideos.filter(v => v.data.category === cat).length;
});

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://techrex.saitejamothukuri.com/" },
    { "@type": "ListItem", "position": 2, "name": "Videos", "item": "https://techrex.saitejamothukuri.com/videos/" }
  ]
};

const videoListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "TechRex Videos",
  "description": "AI tools, local models, developer workflows, and hardware guides.",
  "url": "https://techrex.saitejamothukuri.com/videos/",
  "numberOfItems": sortedVideos.length,
  "itemListElement": sortedVideos.map((video, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "VideoObject",
      "name": video.title,
      "description": video.description,
      "thumbnailUrl": `https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`,
      "uploadDate": video.publishedAt.toISOString(),
      "url": `https://www.youtube.com/watch?v=${video.id}`,
      "embedUrl": `https://www.youtube.com/embed/${video.id}`,
      "publisher": {
        "@type": "Organization",
        "name": "TechRex",
        "url": "https://techrex.saitejamothukuri.com/"
      }
    }
  }))
};
---
<BaseLayout
  title="All Videos — TechRex"
  description="Browse all TechRex videos on AI tools, local AI models, AI assistants, and hardware guides. Filter by category."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(videoListSchema)} />
  </Fragment>
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Page header -->
      <div class="mb-10">
        <h1 class="font-heading font-bold text-4xl sm:text-5xl text-[var(--color-text)] mb-3">
          Videos
        </h1>
        <p class="text-[var(--color-muted)] text-base max-w-xl">
          {allVideos.length} videos covering AI tools, local models, developer workflows, and hardware.
        </p>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed max-w-2xl mt-4">
          Each tutorial is paired with practical context from the <a href="/resources/" class="font-semibold text-primary hover:text-primary-hover transition-colors">Resources</a> page and the channel background on <a href="/about/" class="font-semibold text-primary hover:text-primary-hover transition-colors">About</a>, so you can move from ideas to implementation faster.
        </p>
      </div>

      <!-- Category stats bar -->
      <div class="flex flex-wrap gap-2 mb-8 pb-8 border-b border-[var(--color-border)]">
        {categories.map(cat => (
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]">
            <span class="text-xs text-[var(--color-muted)]">{cat}</span>
            <span class="text-xs font-bold text-[var(--color-text)]">{counts[cat]}</span>
          </div>
        ))}
      </div>

      <!-- Filter -->
      <div class="mb-8">
        <CategoryFilter categories={categories} />
      </div>

      <!-- Grid — VideoCard already has data-category-card on its <article> for filter JS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedVideos.map(video => (
          <VideoCard video={video} />
        ))}
      </div>

    </div>
  </section>
</BaseLayout>
