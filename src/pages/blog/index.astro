---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import blogData from '../../data/blog-posts.json';
import liveData from '../../data/live-blogs.json';

const posts = blogData.blogPosts.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const liveUrls = new Set(liveData.map((b: { url: string }) => b.url.replace('http://', 'https://')));
const categories = ['All', ...Array.from(new Set(posts.map(p => p.category)))];

const AUTHOR = {
  "@type": "Person",
  "name": "Saiteja Mothukuri",
  "url": "https://saitejamothukuri.com"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://techrex.saitejamothukuri.com" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://techrex.saitejamothukuri.com/blog" }
  ]
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "TechRex Blog",
  "url": "https://techrex.saitejamothukuri.com/blog",
  "description": "In-depth guides, tutorials and comparisons on AI tools, local models and developer workflows.",
  "author": AUTHOR,
  "publisher": {
    "@type": "Organization",
    "name": "TechRex",
    "url": "https://techrex.saitejamothukuri.com"
  },
  "blogPost": posts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "url": post.bloggerUrl,
    "datePublished": new Date(post.date).toISOString(),
    "image": `https://img.youtube.com/vi/${post.youtubeId}/maxresdefault.jpg`,
    "keywords": post.tags.join(", "),
    "articleSection": post.category,
    "author": AUTHOR,
    "publisher": {
      "@type": "Organization",
      "name": "TechRex",
      "url": "https://techrex.saitejamothukuri.com"
    }
  }))
};

function thumbUrl(youtubeId: string) {
  return `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`;
}

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric'
  });
}
---
<BaseLayout
  title="Blog — TechRex"
  description="Written tutorials, deep dives and guides on AI tools, local models and developer workflows from TechRex."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  </Fragment>
  <!-- Hero -->
  <section class="py-20 bg-[var(--color-surface)] border-b border-[var(--color-border)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] text-xs font-semibold uppercase tracking-wide mb-4">
        {posts.length} Articles
      </span>
      <h1 class="font-heading font-bold text-4xl sm:text-5xl text-[var(--color-text)] mb-4">
        TechRex Blog
      </h1>
      <p class="text-[var(--color-muted)] text-lg max-w-2xl mx-auto">
        In-depth guides, tutorials and comparisons on AI tools, local models and developer workflows.
      </p>
    </div>
  </section>

  <!-- Category Filter -->
  <section class="sticky top-0 z-20 bg-[var(--color-bg)]/95 backdrop-blur-sm border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex gap-2 overflow-x-auto py-3" style="scrollbar-width:none">
        {categories.map(cat => (
          <button
            data-blog-filter={cat}
            class={`shrink-0 px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-150 cursor-pointer border
              ${cat === 'All'
                ? 'bg-primary text-white border-primary'
                : 'bg-transparent text-[var(--color-muted)] border-[var(--color-border)] hover:border-primary hover:text-primary'
              }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => {
          const isLive = liveUrls.has(post.bloggerUrl);
          return (
            <article
              data-blog-card={post.category}
              class="group flex flex-col bg-[var(--color-card)] border border-[var(--color-border)] rounded-xl overflow-hidden
                     hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 transition-all duration-200"
            >
              <!-- Thumbnail -->
              <a
                href={post.bloggerUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block relative overflow-hidden"
                style="aspect-ratio:16/9"
              >
                <img
                  src={thumbUrl(post.youtubeId)}
                  alt={post.title}
                  loading="lazy"
                  width="480"
                  height="270"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                {isLive && (
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-[var(--color-secondary)] text-white text-[10px] font-bold uppercase tracking-wide">
                    Live
                  </span>
                )}
              </a>

              <!-- Content -->
              <div class="flex flex-col flex-1 p-5">
                <div class="flex items-center justify-between gap-2 mb-3">
                  <CategoryBadge category={post.category} />
                  <time class="text-xs text-[var(--color-muted)]">{formatDate(post.date)}</time>
                </div>

                <h2 class="font-heading font-bold text-base text-[var(--color-text)] leading-snug mb-2 group-hover:text-primary transition-colors duration-150" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                  <a href={post.bloggerUrl} target="_blank" rel="noopener noreferrer">
                    {post.title}
                  </a>
                </h2>

                <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4 flex-1" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                  {post.excerpt}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {post.tags.slice(0, 3).map(tag => (
                    <span class="px-2 py-0.5 rounded-md bg-[var(--color-surface)] text-[var(--color-muted)] text-[11px] font-medium border border-[var(--color-border)]">
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- Actions -->
                <div class="flex items-center gap-2 mt-auto">
                  <a
                    href={post.bloggerUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-primary text-white text-xs font-semibold hover:bg-primary-hover active:scale-95 transition-all duration-150 cursor-pointer"
                  >
                    Read Article
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                  <a
                    href={`https://www.youtube.com/watch?v=${post.youtubeId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Watch on YouTube"
                    class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:border-red-500 hover:text-red-500 transition-all duration-150 cursor-pointer"
                    aria-label="Watch on YouTube"
                  >
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Subscribe CTA -->
  <section class="py-20 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-heading font-bold text-2xl sm:text-3xl text-[var(--color-text)] mb-3">
        Stay in the Loop
      </h2>
      <p class="text-[var(--color-muted)] mb-8">
        New articles drop every week. Follow on Blogger or subscribe on YouTube to catch them first.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="https://saitejatechrex.blogspot.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[var(--color-accent)] text-white font-semibold text-sm hover:opacity-90 active:scale-95 transition-all duration-150 cursor-pointer"
        >
          Follow on Blogger
        </a>
        <a
          href="https://www.youtube.com/@The_TechRex?sub_confirmation=1"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-[var(--color-border)] text-[var(--color-text)] font-semibold text-sm hover:border-red-500 hover:text-red-500 transition-all duration-150 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          Subscribe on YouTube
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-blog-card]');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.blogFilter!;

      buttons.forEach(b => {
        b.classList.remove('bg-primary', 'text-white', 'border-primary');
        b.classList.add('bg-transparent', 'text-[var(--color-muted)]', 'border-[var(--color-border)]');
      });
      btn.classList.add('bg-primary', 'text-white', 'border-primary');
      btn.classList.remove('bg-transparent', 'text-[var(--color-muted)]', 'border-[var(--color-border)]');

      cards.forEach(card => {
        const show = filter === 'All' || card.dataset.blogCard === filter;
        (card as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>
