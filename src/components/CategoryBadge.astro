---
interface Props {
  category: 'Local AI' | 'AI Tools' | 'AI Assistants' | 'Hardware' | 'About';
  size?: 'sm' | 'md';
}
const { category, size = 'sm' } = Astro.props;

const colorMap: Record<string, string> = {
  'Local AI':      'bg-[#34D399]/15 text-emerald-700 border-2 border-[#34D399]',
  'AI Tools':      'bg-[#8B5CF6]/15 text-violet-700 border-2 border-[#8B5CF6]',
  'AI Assistants': 'bg-[#F472B6]/15 text-pink-700 border-2 border-[#F472B6]',
  'Hardware':      'bg-[#FBBF24]/15 text-amber-700 border-2 border-[#FBBF24]',
  'About':         'bg-[#94A3B8]/15 text-slate-600 border-2 border-[#94A3B8]',
};

const darkColorMap: Record<string, string> = {
  'Local AI':      'dark:bg-[#34D399]/10 dark:text-emerald-400',
  'AI Tools':      'dark:bg-[#8B5CF6]/10 dark:text-violet-400',
  'AI Assistants': 'dark:bg-[#F472B6]/10 dark:text-pink-400',
  'Hardware':      'dark:bg-[#FBBF24]/10 dark:text-amber-400',
  'About':         'dark:bg-[#94A3B8]/10 dark:text-slate-400',
};

const sizeClass = size === 'sm' ? 'text-xs px-2 py-0.5' : 'text-sm px-3 py-1';
const colors = colorMap[category] ?? colorMap['About'];
const darkColors = darkColorMap[category] ?? darkColorMap['About'];
---
<span class={`inline-flex items-center rounded-full font-bold ${sizeClass} ${colors} ${darkColors}`}>
  {category}
</span>
