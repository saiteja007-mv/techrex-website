---
interface Props {
  category: 'Local AI' | 'AI Tools' | 'AI Assistants' | 'Hardware' | 'About';
  size?: 'sm' | 'md';
}
const { category, size = 'sm' } = Astro.props;

const colorMap: Record<string, string> = {
  'Local AI':      'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950 dark:text-emerald-400 dark:border-emerald-800',
  'AI Tools':      'bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950 dark:text-blue-400 dark:border-blue-800',
  'AI Assistants': 'bg-purple-50 text-purple-700 border border-purple-200 dark:bg-purple-950 dark:text-purple-400 dark:border-purple-800',
  'Hardware':      'bg-orange-50 text-orange-700 border border-orange-200 dark:bg-orange-950 dark:text-orange-400 dark:border-orange-800',
  'About':         'bg-gray-50 text-gray-600 border border-gray-200 dark:bg-gray-900 dark:text-gray-400 dark:border-gray-700',
};
const sizeClass = size === 'sm' ? 'text-xs px-2 py-0.5' : 'text-sm px-3 py-1';
const colors = colorMap[category] ?? colorMap['About'];
---
<span class={`inline-flex items-center rounded-md font-medium ${sizeClass} ${colors}`}>
  {category}
</span>
