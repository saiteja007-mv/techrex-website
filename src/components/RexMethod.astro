---
const pillars = [
  {
    letter: 'R',
    name: 'Resources',
    tagline: 'Tools you need',
    description: 'Curated tools, software, and hardware recommendations that actually work. No fluff, just the essentials to get started.',
    letterBg: 'bg-[#8B5CF6]',
    shadow: 'shadow-hard-violet',
  },
  {
    letter: 'E',
    name: 'Experiments',
    tagline: 'Projects we build',
    description: 'Hands-on projects and tutorials where we test the latest AI tools so you know exactly what works before investing your time.',
    letterBg: 'bg-[#34D399]',
    shadow: 'shadow-hard-mint',
  },
  {
    letter: 'X',
    name: 'eXecution',
    tagline: 'Real implementations',
    description: 'Step-by-step guides to actually ship. From zero to working implementation — the practical side that most tutorials skip.',
    letterBg: 'bg-[#FBBF24]',
    shadow: 'shadow-hard-amber',
  },
] as const;
---
<section class="py-20 bg-[var(--color-surface)] relative overflow-hidden">
  <!-- Dots -->
  <div class="absolute inset-0 pattern-dots opacity-[0.03] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-14">
      <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-4 shadow-hard-sm">
        Framework
      </span>
      <h2 class="font-heading font-extrabold text-3xl sm:text-4xl text-[var(--color-text)] mb-4">
        The <span class="text-primary">REX</span> Method
      </h2>
      <p class="text-[var(--color-muted)] max-w-xl mx-auto text-base leading-relaxed">
        Every video follows a proven framework designed to take you from curious to capable.
      </p>
    </div>

    <!-- Pillars grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pillars.map((pillar) => (
        <div class={`p-6 rounded-2xl border-2 border-[var(--color-border)] bg-[var(--color-card)] ${pillar.shadow} hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200`}>
          <!-- Letter badge -->
          <div class={`inline-flex items-center justify-center w-14 h-14 rounded-xl ${pillar.letterBg} text-white text-3xl font-extrabold font-heading mb-5 border-2 border-[var(--color-border)]`} style="box-shadow: 3px 3px 0px 0px var(--color-border)">
            {pillar.letter}
          </div>

          <h3 class="font-heading font-bold text-lg text-[var(--color-text)] mb-1">
            {pillar.name}
          </h3>
          <p class="text-sm font-bold text-[var(--color-muted)] mb-3">
            {pillar.tagline}
          </p>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
