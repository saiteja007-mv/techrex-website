---
import { Image } from 'astro:assets';
import channelInfo from '../data/channel-info.json';
import avatar from '../assets/channel-avatar.jpg';

const { branding, socialLinks } = channelInfo;
const stats = channelInfo.channel.statistics;

const formattedViews = parseInt(stats.viewCount).toLocaleString('en-US');
---
<section class="py-24 bg-[var(--color-bg)] relative overflow-hidden">

  <!-- Polka dot background (subtle) -->
  <div class="absolute inset-0 pattern-dots opacity-[0.04] pointer-events-none"></div>

  <!-- Decorative geometric shapes -->
  <div class="absolute top-12 left-8 w-10 h-10 rounded-full bg-secondary/25 border-2 border-secondary hidden lg:block"></div>
  <div class="absolute top-24 right-12 w-6 h-6 bg-[var(--color-accent)] border-2 border-[var(--color-border)] rotate-45 hidden lg:block" style="box-shadow: 2px 2px 0px 0px var(--color-border)"></div>
  <div class="absolute bottom-16 left-16 w-8 h-8 bg-[var(--color-mint)] border-2 border-[var(--color-border)] rounded-lg rotate-12 hidden lg:block" style="box-shadow: 3px 3px 0px 0px var(--color-border)"></div>
  <div class="absolute bottom-20 right-20 w-12 h-4 bg-primary/20 border-2 border-primary rounded-full hidden lg:block"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col items-center text-center gap-8">

      <!-- Avatar with hard border -->
      <div class="w-28 h-28 rounded-2xl overflow-hidden border-4 border-[var(--color-border)] flex-shrink-0 bg-[var(--color-card)]" style="box-shadow: 6px 6px 0px 0px var(--color-border)">
        <Image
          src={avatar}
          alt="TechRex channel avatar"
          width={112}
          height={112}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Text block -->
      <div class="max-w-2xl">
        <!-- Handle badge -->
        <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-surface)] border-2 border-[var(--color-border)] text-xs font-semibold text-[var(--color-muted)] mb-4 shadow-hard-sm">
          @The_TechRex
        </span>

        <!-- Title -->
        <h1 class="font-heading font-extrabold text-6xl sm:text-7xl leading-none tracking-tight mb-4">
          <span class="text-[var(--color-text)]">Tech</span><span class="text-primary">Rex</span>
        </h1>

        <!-- Tagline with typewriter -->
        <p class="text-lg text-[var(--color-muted)] max-w-md mx-auto leading-relaxed mb-8">
          Learn. Build. Launch <span id="typewriter-text" class="text-primary font-bold"></span><span id="typewriter-cursor" class="text-primary font-bold animate-pulse">|</span>
        </p>

        <!-- Candy CTAs -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/videos"
            class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-primary text-white text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
            style="box-shadow: 4px 4px 0px 0px var(--color-border);"
            onmouseover="this.style.boxShadow='6px 6px 0px 0px var(--color-border)'"
            onmouseout="this.style.boxShadow='4px 4px 0px 0px var(--color-border)'"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
            Watch Videos
          </a>
          <a
            href={socialLinks.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-[var(--color-bg)] text-[var(--color-text)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
            style="box-shadow: 4px 4px 0px 0px var(--color-border);"
            onmouseover="this.style.boxShadow='6px 6px 0px 0px var(--color-border)'"
            onmouseout="this.style.boxShadow='4px 4px 0px 0px var(--color-border)'"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Subscribe on YouTube
          </a>
          <a
            href="/token-usage"
            class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-[var(--color-bg)] text-[var(--color-text)] text-sm font-bold border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
            style="box-shadow: 4px 4px 0px 0px var(--color-border);"
            onmouseover="this.style.boxShadow='6px 6px 0px 0px var(--color-border)'"
            onmouseout="this.style.boxShadow='4px 4px 0px 0px var(--color-border)'"
          >
            <svg class="w-4 h-4 text-[var(--color-mint)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>
            </svg>
            Token Usage
          </a>
        </div>
      </div>

      <!-- Stats row: hard border boxes -->
      <div class="flex items-center gap-3 pt-2 flex-wrap justify-center">
        <div class="px-6 py-3 bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-xl shadow-hard text-center min-w-[100px]">
          <p id="stat-views" class="font-heading font-bold text-2xl text-[var(--color-text)]">{formattedViews}</p>
          <p class="text-xs text-[var(--color-muted)] uppercase tracking-wide mt-0.5">Total Views</p>
        </div>
        <div class="px-6 py-3 bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-xl shadow-hard text-center min-w-[100px]">
          <p id="stat-subs" class="font-heading font-bold text-2xl text-[var(--color-text)]">{stats.subscriberCount}</p>
          <p class="text-xs text-[var(--color-muted)] uppercase tracking-wide mt-0.5">Subscribers</p>
        </div>
        <div class="px-6 py-3 bg-[var(--color-card)] border-2 border-[var(--color-border)] rounded-xl shadow-hard text-center min-w-[100px]">
          <p id="stat-videos" class="font-heading font-bold text-2xl text-[var(--color-text)]">{stats.videoCount}</p>
          <p class="text-xs text-[var(--color-muted)] uppercase tracking-wide mt-0.5">Videos</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initTypewriter() {
    const textEl   = document.getElementById('typewriter-text');
    const cursorEl = document.getElementById('typewriter-cursor');
    if (!textEl || !cursorEl) return;

    const phrases   = ['with TechRex', 'without the struggle', 'at your own pace', 'with the right tools'];
    const speed     = 60;   // ms per character typed
    const deleteSpeed = 35; // ms per character deleted
    const waitTime  = 2200; // ms to wait before deleting

    let phraseIndex   = 0;
    let charIndex     = 0;
    let isDeleting    = false;
    let timer: ReturnType<typeof setTimeout>;

    function tick() {
      const current = phrases[phraseIndex];

      if (!isDeleting) {
        // Typing
        charIndex++;
        textEl.textContent = current.slice(0, charIndex);
        if (charIndex === current.length) {
          // Pause before deleting; hide cursor blink while paused
          cursorEl.style.opacity = '1';
          timer = setTimeout(() => { isDeleting = true; tick(); }, waitTime);
          return;
        }
        timer = setTimeout(tick, speed);
      } else {
        // Deleting
        charIndex--;
        textEl.textContent = current.slice(0, charIndex);
        if (charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          timer = setTimeout(tick, 400); // short pause before typing next
          return;
        }
        timer = setTimeout(tick, deleteSpeed);
      }
    }

    // Kick off with a short initial delay
    timer = setTimeout(tick, 800);

    // Cleanup on Astro page transitions
    document.addEventListener('astro:before-swap', () => clearTimeout(timer), { once: true });
  }

  initTypewriter();
  document.addEventListener('astro:page-load', initTypewriter);

  // Fetch live channel stats and update hero numbers
  fetch('/api/channel-stats')
    .then(r => r.ok ? r.json() : null)
    .then(data => {
      if (!data) return;
      const views = document.getElementById('stat-views');
      const subs  = document.getElementById('stat-subs');
      const vids  = document.getElementById('stat-videos');
      if (views) views.textContent = parseInt(data.viewCount).toLocaleString('en-US');
      if (subs)  subs.textContent  = parseInt(data.subscriberCount).toLocaleString('en-US');
      if (vids)  vids.textContent  = parseInt(data.videoCount).toLocaleString('en-US');
    })
    .catch(() => {});
</script>
