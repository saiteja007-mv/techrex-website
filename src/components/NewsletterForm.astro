---
// Visual form — backend connection added later
---
<section class="border-t-2 border-[var(--color-border)] py-16 bg-[var(--color-surface)] relative overflow-hidden">
  <!-- Decorative shapes -->
  <div class="absolute top-6 right-8 w-8 h-8 rounded-full bg-primary/20 border-2 border-primary hidden sm:block"></div>
  <div class="absolute bottom-6 left-10 w-6 h-6 bg-[var(--color-accent)]/30 border-2 border-[var(--color-accent)] rotate-45 hidden sm:block"></div>

  <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center relative z-10">
    <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-card)] border-2 border-[var(--color-border)] text-xs font-bold text-[var(--color-muted)] mb-4 shadow-hard-sm">
      Newsletter
    </span>
    <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-[var(--color-text)] mb-3">
      Stay Ahead of the AI Curve
    </h2>
    <p class="text-[var(--color-muted)] mb-8 text-sm sm:text-base leading-relaxed">
      Get weekly breakdowns of the best AI tools, local model setups, and developer workflows — delivered to your inbox.
    </p>

    <form
      class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
      action="#"
      method="POST"
    >
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        placeholder="your@email.com"
        autocomplete="email"
        class="flex-1 px-4 py-2.5 rounded-full border-2 border-[var(--color-border)] bg-[var(--color-card)]
               text-[var(--color-text)] placeholder:text-[var(--color-muted)] text-sm font-medium
               focus:outline-none focus:border-primary transition-colors duration-150 shadow-hard-sm"
      />
      <button
        type="submit"
        class="px-6 py-2.5 rounded-full bg-[var(--color-accent)] text-[var(--color-text)] font-bold text-sm
               border-2 border-[var(--color-border)] shadow-hard hover:-translate-x-0.5 hover:-translate-y-0.5
               transition-all duration-200 cursor-pointer whitespace-nowrap"
        style="box-shadow: 4px 4px 0px 0px var(--color-border);"
      >
        Subscribe Free
      </button>
    </form>
    <p class="mt-3 text-xs text-[var(--color-muted)] font-medium">No spam. Unsubscribe anytime.</p>
  </div>
</section>

<script>
  function initNewsletterForm() {
    const form = document.querySelector<HTMLFormElement>('form[action="#"]');
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type="email"]');
      if (!input?.value) return;

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) {
        btn.textContent = 'Coming Soon!';
        btn.disabled = true;
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        setTimeout(() => {
          btn.textContent = 'Subscribe Free';
          btn.disabled = false;
          btn.classList.remove('opacity-75', 'cursor-not-allowed');
          input.value = '';
        }, 2500);
      }
    });
  }

  initNewsletterForm();
  document.addEventListener('astro:page-load', initNewsletterForm);
</script>
