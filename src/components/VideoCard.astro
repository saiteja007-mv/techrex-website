---
import { Image } from 'astro:assets';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  video: {
    id: string;
    title: string;
    thumbnail: string;
    category: 'Local AI' | 'AI Tools' | 'AI Assistants' | 'Hardware' | 'About';
    publishedAt: Date;
    description: string;
  };
}
const { video } = Astro.props;

// Load all thumbnails via import.meta.glob for Astro optimization
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/thumbnails/*.jpg', { eager: true });
const thumbFilename = video.thumbnail.replace('thumbnails/', '');
const imgSrc = images[`/src/assets/thumbnails/${thumbFilename}`]?.default;

const youtubeUrl = `https://www.youtube.com/watch?v=${video.id}`;
const dateStr = video.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const shortDesc = video.description.length > 120 ? video.description.slice(0, 117) + '...' : video.description;
---
<article
  class="group bg-[var(--color-card)] rounded-lg border border-[var(--color-border)] hover:border-primary/40
         transition-all duration-150 cursor-pointer flex flex-col overflow-hidden"
  data-category-card={video.category}
>
  <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="block" aria-label={`Watch: ${video.title}`}>
    <!-- Thumbnail -->
    <div class="relative aspect-video overflow-hidden rounded-t-lg bg-[var(--color-surface)]">
      {imgSrc ? (
        <Image
          src={imgSrc}
          alt={video.title}
          width={400}
          height={225}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
        />
      ) : (
        <div class="w-full h-full bg-[var(--color-surface)] flex items-center justify-center">
          <svg class="w-10 h-10 text-[var(--color-muted)]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      )}
      <!-- Play overlay on hover -->
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-150 flex items-center justify-center">
        <div class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-150">
          <svg class="w-4 h-4 text-gray-900 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
    </div>
  </a>

  <!-- Content -->
  <div class="p-4 flex flex-col flex-1 gap-2">
    <div class="flex items-center justify-between gap-2">
      <CategoryBadge category={video.category} />
      <time class="text-xs text-[var(--color-muted)]" datetime={video.publishedAt.toISOString()}>
        {dateStr}
      </time>
    </div>

    <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="cursor-pointer">
      <h3 class="font-semibold text-sm text-[var(--color-text)] leading-snug line-clamp-2
                 hover:text-primary transition-colors duration-150">
        {video.title}
      </h3>
    </a>

    <p class="text-xs text-[var(--color-muted)] leading-relaxed line-clamp-2 flex-1">
      {shortDesc}
    </p>

    <a
      href={youtubeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-xs font-medium text-primary hover:text-primary-hover transition-colors duration-150 cursor-pointer mt-auto w-fit"
    >
      Watch
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
